import { ListView, LineEdit, ComboBox, CheckBox, Button, SpinBox, ScrollView, TextEdit } from "std-widgets.slint";

// Live-dropdown rows. We keep contacts and messages as separate models
// so the Slint side can render them in their own sections — see
// search-contacts / search-messages on MainWindow.
struct ContactItem {
    name: string,
    email: string,
}

struct MessageHit {
    from: string,
    subject: string,
    date: string,
}

// One connection row in Settings → Подключения.
struct ConnRow {
    title: string,      // account email / name
    subtitle: string,   // server + mode
}

// One row of the connection-light dropdown: an account and whether it is
// currently up. Binary on purpose — the aggregate light already carries the
// «частично» state, a per-account row is either connected or it is not.
struct ConnDotRow {
    title: string,
    subtitle: string,
    ok: bool,
}

// One row of the unified address book (view-mode 2). Aggregated server-side;
// the client shows one book and never groups by source.
struct AddrBookRow {
    name: string,
    detail: string,   // primary email, or organization
    initials: string,
    color: brush,     // initials-bubble tint
    email: string,    // primary email (for compose-to on click)
}

struct ConvItem {
    name: string,
    preview: string,
    initials: string,
    color: brush,
    time: string,
    avatar: image,
    has-avatar: bool,
    // Row tint = pastel colour of the identity that RECEIVED the
    // conversation (transparent for the synthetic compose row).
    ident-color: brush,
    // Unread badge value; 0 = no badge (Tauri-era pill).
    unread: int,
    // One-second attention flash when new mail lands in this conversation.
    highlight: bool,
    // Row is a user-made merge of several conversations (merges.json) —
    // shows the «Разъединить» context-menu item.
    is-merged: bool,
}

// One attendee row of the event-detail table: display name + localized
// participation status with its colour.
struct AttRow {
    name: string,
    status: string,
    color: color,
}

// One merged selection-highlight rect (bubble-relative CSS px).
struct SelRect {
    x: length,
    y: length,
    w: length,
    h: length,
}

// One row of the «Показать → Заголовки» table: header name + raw value,
// in the order they appear in the message.
struct HeaderRow {
    name: string,
    value: string,
}

// Each message row is a full-width image rendered by Blitz (bubble, alignment,
// formatting and network images all done in HTML/CSS inside Blitz).
struct RowItem {
    img: image,
    h: length,
    // Drives the context menu's «Показать…» items: whether HTML / plain-text
    // parts exist for this message, and whether HTML is the currently shown
    // view. has-text / has-html gate the version-switch items so we never
    // offer to switch to a version that isn't there.
    has-html: bool,
    has-text: bool,
    viewing-html: bool,
    // «Медиа…» menu data: sender address, first external image/script
    // hosts (empty = none), and the per-sender/per-host checkbox states.
    sender: string,
    media-host: string,
    script-host: string,
    m-sender-on: bool,
    s-sender-on: bool,
    m-host-on: bool,
    s-host-on: bool,
}

// Calendar list row in the calendar-mode sidebar.
struct CalendarItem {
    id: int,
    name: string,
    color: color,
    visible: bool,
}

// One event block on the week grid. (day-col, top, h, color, title, time)
// are all computed Rust-side — Slint just places the rectangles.
struct EventBlock {
    id: int,
    day: int,            // 0..days-shown - 1
    top: length,
    h: length,
    color: color,
    title: string,
    time: string,
    all-day: bool,
    // Horizontal lane within the day column for overlapping events:
    // x-fraction and width-fraction of the column (0..1). Computed
    // Rust-side; non-overlapping blocks get xf=0, wf=1.
    xf: float,
    wf: float,
    // Tauri-era card content: attendee count (badge shown when >= 2) and
    // the "unanswered meeting" look (invited, no RSVP yet → lighter).
    count: int,
    tentative: bool,
    // Calendar is writable → this block can be dragged / resized.
    writable: bool,
}

// One all-day chip in the band above the hour grid. Multi-day all-day
// events expand to one chip per day touched; `row` stacks chips that share
// a day so they don't overprint.
struct AllDayBlock {
    id: int,
    day: int,            // 0..days-shown - 1
    row: int,            // vertical slot within the band
    color: color,
    title: string,
}

// One staged attachment chip in the composer. `name` is the basename shown
// to the user; the Rust side keeps the full path parallel to this model.
struct AttachChip {
    name: string,
}

// A sending identity in the composer's from-picker. `tint` mirrors the
// sidebar identity colour so the dot is recognisable across the app.
struct IdentityItem {
    label: string,
    email: string,
    tint: color,
}

// One attendee row in the event card's read-only block. `dot` encodes the
// participation status (green accepted / red declined / orange tentative /
// grey no answer) — computed Rust-side from PARTSTAT.
struct AttendeeItem {
    label: string,
    dot: color,
}

// One extra event property (conference link, URL, categories…). Links are
// clickable and open in the browser.
struct EventExtraItem {
    label: string,
    value: string,
    is-link: bool,
}

// Раскладко-независимые Ctrl+C/X/V/A.
//
// Slint сопоставляет клавиатурные шорткаты по СИМВОЛУ события
// (i-slint-core/input.rs: `match key_event.text { "c" => Copy, ... }`), а
// winit кладёт в `text` символ ТЕКУЩЕЙ раскладки. Под ЙЦУКЕН приходят
// «с»/«ч»/«м»/«ф» — ни один шорткат не матчится, и буфер обмена молча
// перестаёт работать во всех полях ввода (карточка события, композер,
// поиск, логин). Физических кодов клавиш Slint наружу не отдаёт, поэтому
// классифицируем событие сами — по кириллическим буквам тех же клавиш.
//
// Латиницу не перехватываем: там штатный путь Slint работает.

// TextInput с починенными шорткатами (см. global Kb). Все поля ввода в
// приложении — это он, а не голый TextInput.
//
// Собственные шорткаты поля (Enter=отправить, Esc, стрелки) вешаются на
// `extra-key-pressed`: `key-pressed` уже занят и вызывает его последним,
// после clipboard-шорткатов. Без хука биндинг на месте использования
// перекрыл бы наш обработчик и починка потерялась бы молча.
component KTextInput inherits TextInput {
    callback extra-key-pressed(event: KeyEvent) -> EventResult;
    // Ctrl зажат, Alt нет, Shift нет: AltGr представляется как Ctrl+Alt, а
    // Ctrl+Shift — это другой набор шорткатов.
    property <bool> held: false;
    key-pressed(ev) => {
        self.held = ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.shift;
        if (Shortcuts.action(ev.text, self.held) == 1) { self.copy(); return accept; }
        if (Shortcuts.action(ev.text, self.held) == 4) { self.select-all(); return accept; }
        // Мутирующие — только в редактируемом поле (штатный путь Slint
        // проверяет read-only так же).
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 3) { self.cut(); return accept; }
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 2) { self.paste(); return accept; }
        return self.extra-key-pressed(ev);
    }
}

// То же для std-widget LineEdit (настройки/логин/контакты) — у него
// шорткаты ломаются по той же причине.
component KLineEdit inherits LineEdit {
    property <bool> held: false;
    key-pressed(ev) => {
        self.held = ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.shift;
        if (Shortcuts.action(ev.text, self.held) == 1) { self.copy(); return accept; }
        if (Shortcuts.action(ev.text, self.held) == 4) { self.select-all(); return accept; }
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 3) { self.cut(); return accept; }
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 2) { self.paste(); return accept; }
        return reject;
    }
}

// A horizontal dashed hairline — Slint has no stroke-dash, so we tile fixed
// dash segments. `count` (period 24px) comes from Rust, sized to the grid.
// Which editing action a key press means, decided in Rust against the
// *current* keyboard layout.
//
// Slint cannot answer this: its own shortcut matcher compares `event.text`
// with the latin letters "c"/"x"/"v"/"a" (i-slint-core/input.rs), so on any
// non-latin layout neither the built-in handling nor anything written in
// `.slint` fires. The character is all we get — so Rust asks the OS which
// physical key produces that character right now, and answers by key.
//
// 0 none, 1 copy, 2 paste, 3 cut, 4 select-all.
export global Shortcuts {
    // `held` must be "Ctrl is down and Alt is not". It is a parameter rather
    // than something the caller is trusted to check first, because forgetting
    // it turns every letter into a shortcut — plain "a" selected all and "x"
    // cut the selection.
    //
    // Alt is excluded because AltGr reports itself as Ctrl+Alt on Windows, and
    // on layouts that put characters there, typing would fire shortcuts.
    callback action(string, bool) -> int;
}


component DashLine inherits Rectangle {
    in property <int> count: 0;
    in property <color> seg-color: #cfd6df;
    height: 1px;
    for k in root.count: Rectangle {
        x: k * 24px;
        width: 13px;
        height: 1px;
        background: root.seg-color;
    }
}

// iOS-style pill switch used across the settings modal. `on` drives the
// look; `toggled` fires on click — the parent owns the state.
component Toggle inherits Rectangle {
    in property <bool> on: false;
    in property <bool> enabled: true;
    callback toggled();
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: !root.enabled ? #e6ecf2 : (root.on ? #10b981 : #c7cdd6);
    animate background { duration: 120ms; }
    opacity: root.enabled ? 1.0 : 0.5;
    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        animate x { duration: 120ms; easing: ease-out; }
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000033;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}

// One labelled settings line: title + optional subtitle on the left, an
// arbitrary control slotted on the right via `@children`.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    height: subtitle == "" ? 48px : 60px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
                color: #0f1419;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 12px;
                color: #6b7480;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// One «напомнить позже» option: `value` is what the snooze-choice callback
// passes back ("5"/"30"/… minutes, or "atstart"); `label` is the display text.
export struct SnoozeOpt {
    value: string,
    label: string,
}

// Labelled text field for the event form — custom-styled (the std-widget
// LineEdit/ComboBox render poorly here), built on the low-level TextInput so
// the label and border are always visible.
component CalField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> value;
    spacing: 3px;
    Text {
        text: root.label;
        font-size: 12px;
        color: #5b6672;
    }
    Rectangle {
        height: 34px;
        background: white;
        border-radius: 7px;
        border-width: 1px;
        border-color: ti.has-focus ? #10b981 : #c8d4e4;
        TouchArea {
            clicked => { ti.focus(); }
        }
        if root.value == "": Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            vertical-alignment: center;
            text: root.placeholder;
            color: #9aa5b1;
            font-size: 14px;
            overflow: elide;
        }
        ti := KTextInput {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            vertical-alignment: center;
            text <=> root.value;
            font-size: 14px;
            color: #0f1419;
            single-line: true;
        }
    }
}

// Дата/время пикер карточки события: поле «ДД.ММ.ГГГГ ЧЧ:ММ» + всплывающий
// месяц-календарь и степперы времени (шаг минут — 5). Источник истины —
// числовые компоненты (year/month/day/hour/minute), которые Rust заполняет
// при открытии формы и читает при сохранении; всю дата-математику
// (григорианский календарь, день недели, длина месяца) компонент делает сам,
// без раунд-трипов в Rust. PopupWindow рисуется поверх модалки и закрывается
// по клику вне себя.
component DateTimeField inherits VerticalLayout {
    in property <string> label;
    in property <bool> all-day;
    in-out property <int> year: 2026;
    in-out property <int> month: 1;   // 1–12
    in-out property <int> day: 1;     // 1–31
    in-out property <int> hour: 0;    // 0–23
    in-out property <int> minute: 0;  // 0–59
    // Месяц, показываемый в сетке (навигация ‹ ›), отдельно от выбранной даты.
    property <int> view-year: 2026;
    property <int> view-month: 1;

    property <[int]> sakamoto: [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    property <[string]> months: ["Январь", "Февраль", "Март", "Апрель", "Май",
        "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"];

    pure function pad(n: int) -> string { return n < 10 ? "0\{n}" : "\{n}"; }
    // Число дней в месяце (с високосным февралём).
    pure function dim(y: int, m: int) -> int {
        return m == 2
            ? ((Math.mod(y, 4) == 0 && (Math.mod(y, 100) != 0 || Math.mod(y, 400) == 0)) ? 29 : 28)
            : ((m == 4 || m == 6 || m == 9 || m == 11) ? 30 : 31);
    }
    // День недели 1-го числа, Пн=0..Вс=6 (Сакамото, затем сдвиг с Вс на Пн).
    pure function fwd(y: int, m: int) -> int {
        return Math.mod(Math.mod(
            (m < 3 ? y - 1 : y)
            + Math.floor((m < 3 ? y - 1 : y) / 4)
            - Math.floor((m < 3 ? y - 1 : y) / 100)
            + Math.floor((m < 3 ? y - 1 : y) / 400)
            + root.sakamoto[m - 1] + 1, 7) + 6, 7);
    }

    spacing: 3px;
    Text { text: root.label; font-size: 12px; color: #5b6672; }
    field := Rectangle {
        height: 34px;
        background: white;
        border-radius: 7px;
        border-width: 1px;
        border-color: fta.has-hover || pop-open ? #10b981 : #c8d4e4;
        property <bool> pop-open: false;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: #0f1419;
                font-size: 14px;
                text: root.all-day
                    ? "\{root.pad(root.day)}.\{root.pad(root.month)}.\{root.year}"
                    : "\{root.pad(root.day)}.\{root.pad(root.month)}.\{root.year}   \{root.pad(root.hour)}:\{root.pad(root.minute)}";
            }
            Text {
                vertical-alignment: center;
                text: "▾";
                color: #8b95a1;
                font-size: 12px;
            }
        }
        fta := TouchArea {
            clicked => {
                root.view-year = root.year;
                root.view-month = root.month;
                pop.show();
            }
        }
        pop := PopupWindow {
            // Дефолт close-on-click закрывал пикер при ЛЮБОМ клике внутри
            // (навигация, выбор дня, степперы). Закрываем только по клику вне;
            // выбор дня в all-day и кнопка «Готово» закрывают явно.
            close-policy: close-on-click-outside;
            x: 0;
            y: field.height + 4px;
            width: 288px;
            height: root.all-day ? 244px : 292px;
            Rectangle {
                background: white;
                border-radius: 10px;
                border-width: 1px;
                border-color: #d8dde6;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000022;
                drop-shadow-offset-y: 4px;
            }
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                // Навигация по месяцам.
                HorizontalLayout {
                    height: 26px;
                    Rectangle {
                        width: 30px;
                        prev-ta := TouchArea {
                            clicked => {
                                if (root.view-month == 1) {
                                    root.view-month = 12;
                                    root.view-year -= 1;
                                } else {
                                    root.view-month -= 1;
                                }
                            }
                        }
                        Text { text: "‹"; font-size: 18px; color: prev-ta.has-hover ? #10b981 : #5b6672;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: "\{root.months[root.view-month - 1]} \{root.view-year}";
                        font-size: 14px;
                        font-weight: 700;
                        color: #2b3640;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 30px;
                        next-ta := TouchArea {
                            clicked => {
                                if (root.view-month == 12) {
                                    root.view-month = 1;
                                    root.view-year += 1;
                                } else {
                                    root.view-month += 1;
                                }
                            }
                        }
                        Text { text: "›"; font-size: 18px; color: next-ta.has-hover ? #10b981 : #5b6672;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                // Заголовок дней недели.
                Rectangle {
                    height: 18px;
                    HorizontalLayout {
                        for wd in ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]: Text {
                            width: 38px;
                            text: wd;
                            font-size: 11px;
                            color: #9aa5b1;
                            horizontal-alignment: center;
                        }
                    }
                }
                // Сетка дней: 6 недель × 7. Номер дня в ячейке i выводится из
                // дня недели 1-го числа (leading) — пустые ячейки скрыты.
                grid := Rectangle {
                    height: 180px;
                    property <int> leading: root.fwd(root.view-year, root.view-month);
                    property <int> ndays: root.dim(root.view-year, root.view-month);
                    for i in 42: cell := Rectangle {
                        property <int> daynum: i - grid.leading + 1;
                        property <bool> valid: daynum >= 1 && daynum <= grid.ndays;
                        property <bool> selected: valid && daynum == root.day
                            && root.view-month == root.month && root.view-year == root.year;
                        x: mod(i, 7) * 38px;
                        y: floor(i / 7) * 30px;
                        width: 38px;
                        height: 30px;
                        Rectangle {
                            width: 30px;
                            height: 28px;
                            border-radius: 7px;
                            background: cell.selected ? #10b981
                                : (day-ta.has-hover && cell.valid ? #eef2f7 : transparent);
                            Text {
                                text: cell.valid ? "\{cell.daynum}" : "";
                                color: cell.selected ? white : #2b3640;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            day-ta := TouchArea {
                                clicked => {
                                    if (cell.valid) {
                                        root.year = root.view-year;
                                        root.month = root.view-month;
                                        root.day = cell.daynum;
                                        if (root.all-day) { pop.close(); }
                                    }
                                }
                            }
                        }
                    }
                }
                // Время (скрыто для «весь день»): часы и минуты степперами,
                // шаг минут — 5.
                if !root.all-day: Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "Время:"; font-size: 13px; color: #5b6672; vertical-alignment: center; }
                        // Часы.
                        Rectangle {
                            width: 44px;
                            height: 30px;
                            border-radius: 7px;
                            background: #eef2f7;
                            Text { text: root.pad(root.hour); font-size: 14px; color: #2b3640;
                                horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            width: 20px;
                            Rectangle {
                                hup := TouchArea { clicked => { root.hour = mod(root.hour + 1, 24); } }
                                Text { text: "▲"; font-size: 9px; color: hup.has-hover ? #10b981 : #5b6672;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                hdn := TouchArea { clicked => { root.hour = mod(root.hour + 23, 24); } }
                                Text { text: "▼"; font-size: 9px; color: hdn.has-hover ? #10b981 : #5b6672;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Text { text: ":"; font-size: 15px; color: #2b3640; vertical-alignment: center; }
                        // Минуты (шаг 5, со снапом к сетке кратных пяти).
                        Rectangle {
                            width: 44px;
                            height: 30px;
                            border-radius: 7px;
                            background: #eef2f7;
                            Text { text: root.pad(root.minute); font-size: 14px; color: #2b3640;
                                horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout {
                            width: 20px;
                            Rectangle {
                                mup := TouchArea {
                                    clicked => { root.minute = mod(floor(root.minute / 5) * 5 + 5, 60); }
                                }
                                Text { text: "▲"; font-size: 9px; color: mup.has-hover ? #10b981 : #5b6672;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                mdn := TouchArea {
                                    clicked => { root.minute = mod(floor(root.minute / 5) * 5 + 55, 60); }
                                }
                                Text { text: "▼"; font-size: 9px; color: mdn.has-hover ? #10b981 : #5b6672;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // Готово — закрывает попап.
                        Rectangle {
                            width: 64px;
                            height: 30px;
                            border-radius: 7px;
                            background: done-ta.has-hover ? #0ea372 : #10b981;
                            Text { text: "Готово"; color: white; font-size: 13px;
                                horizontal-alignment: center; vertical-alignment: center; }
                            done-ta := TouchArea { clicked => { pop.close(); } }
                        }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "ddmail";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 1080px;
    min-height: 600px;

    in property <[ConvItem]> conversations;
    in property <[RowItem]> messages;
    in-out property <int> selected: 0;
    in property <string> active-name;
    in property <string> active-initials;
    // Аватарка собеседника в шапке — та же, что в строке списка диалогов.
    in property <image> active-avatar;
    in property <bool> active-has-avatar;
    in property <brush> active-color;

    // Search-as-compose state. The Rust side debounces typing → fires
    // `search-typed(query)` → fills these three properties from the
    // engine result. `search-compose-email` is the parsed email when the
    // raw query looks like one (regex done on the Rust side), shown as a
    // "Написать xxx@yyy" row at the top of the dropdown.
    in property <[ContactItem]> search-contacts;
    in property <[MessageHit]> search-messages;
    in property <bool> search-loading: false;
    in property <string> search-compose-email: "";
    in-out property <bool> search-open: false;
    in-out property <string> search-query: "";
    // Keyboard nav: -1 = focus is in the input (no row hovered); >= 0 = an
    // explicit row index in the dropdown. Row order: optional compose-row
    // first (when search-compose-email != ""), then contacts, then messages.
    in-out property <int> search-selected-row: -1;

    // Telegram-style quote ribbon above the composer input. Visible when
    // the user has explicitly hit "Ответить" on a bubble; cancelled via
    // the × button or implicitly when the message is sent.
    in property <bool> reply-ribbon-visible: false;
    in property <string> reply-ribbon-from: "";
    in property <string> reply-ribbon-preview: "";
    callback reply-ribbon-cancel();

    // Composer chevron — hides subject / cc behind a single toggle so the
    // base UX matches Telegram (no headers visible by default). Concept
    // spec: only the rare user-driven cases reveal these fields.
    // Auto-derived values are shown as placeholders so users see what
    // would be used when the override is empty.
    in-out property <bool> composer-expanded: false;
    in-out property <string> composer-subject: "";
    in-out property <string> composer-cc: "";
    // Plain-текст композера — зеркало rich-документа, который живёт в Rust
    // (`richtext::Editor`). Пишет его Rust на каждую правку; читают ветки
    // отправки, восстановление после SendFailed и заглушка optimistic send.
    in-out property <string> composer-text: "";

    // ── Rich-text композер ────────────────────────────────────────────────
    // Модель, вёрстка и растеризация — в Rust (richtext.rs / richtext_render.rs);
    // Slint показывает готовый битмап и рисует поверх каретку. Всё, что ниже —
    // односторонний канал «Rust нарисовал» + обратные вызовы ввода.
    in property <image> rt-image;
    // Высота содержимого: ею растёт пузырь (до капа строки композера).
    in property <length> rt-height: 21px;
    in property <length> rt-caret-x: 0px;
    in property <length> rt-caret-y: 0px;
    in property <length> rt-caret-h: 21px;
    // Есть выделение — каретку не мигаем (как в любом текстовом поле).
    in property <bool> rt-has-selection: false;
    // Состояние кнопок форматирования (стиль под кареткой/выделением).
    in property <bool> rt-bold: false;
    in property <bool> rt-italic: false;
    in property <bool> rt-underline: false;
    // Есть что отправлять: текст ИЛИ картинка (письмо из одной картинки —
    // валидное письмо, а composer-text у него пустой). Инверсия — `rt-empty`,
    // по ней показывается плейсхолдер.
    in property <bool> rt-can-send: false;
    in property <bool> rt-empty: true;
    // Панель форматирования видна, пока композер в фокусе (её взводит
    // rt-focus-changed со стороны Rust — так же, как гасит).
    in-out property <bool> composer-format-bar-visible: false;
    // Ширина колонки текста изменилась — Rust переверстает под неё.
    callback rt-resize(width: length);
    // Клавиша: текст события + модификаторы. true — обработали.
    callback rt-key(text: string, ctrl: bool, shift: bool, alt: bool) -> bool;
    // Мышь: 0 — нажали, 1 — тянем, 2 — отпустили, 3 — двойной клик.
    callback rt-pointer(x: length, y: length, kind: int);
    // Тулбар: 0 — жирный, 1 — курсив, 2 — подчёркнутый.
    callback rt-toggle(bit: int);
    callback rt-focus-changed(focused: bool);
    // Inline send confirmation: flipped on by the Rust side once the server
    // acks the send, back off ~2s later — the pill fades via animate.
    in-out property <bool> send-confirm-visible: false;
    // Текст плашки: «✓ Отправлено» после send, «✓ Сохранено» после
    // сохранения вложения — один и тот же ненавязчивый механизм.
    in-out property <string> send-confirm-text: "✓ Отправлено";
    in property <string> composer-subject-auto: "";
    // Effective recipients of an implicit send (the dialog's counterparts,
    // reply-all style) — shown as ghost text in the empty «Кому» field so
    // the user can SEE where a plain reply goes before trusting it.
    in property <string> composer-to-auto: "";
    // Staged attachments for the next outgoing message. Filled by the Rust
    // side after the native file dialog; cleared once the message is staged.
    in property <[AttachChip]> composer-attachments;

    // From-picker: which identity the next message is sent as. The Rust
    // side fills the list, re-aims the index at the conversation's
    // receiving identity on open, and reads it back at send time.
    in property <[IdentityItem]> composer-identities;
    in-out property <int> composer-identity-index: 0;
    in-out property <bool> identity-menu-open: false;
    // Явный выбор отправителя в дропдауне. Rust закрепляет его (побеждает
    // авто-наведение на identity беседы И переустановку при дельта-refetch)
    // и читает приоритетно на отправке — тот же принцип, что «Кому»/тема в §1.
    callback identity-picked(int);

    // Render progress: while a conversation's bubbles stream in from
    // Ultralight, a thin bar above the bubble list shows "M of N done".
    // Visible when total > 0 AND progress < total.
    in property <int> render-progress: 0;
    in property <int> render-total: 0;

    // Sidebar width — adjustable via the draggable handle between the
    // sidebar and the chat pane. Clamped on the drag callback.
    in-out property <length> sidebar-width: 320px;

    // ── View mode ──
    //
    // 0 = Mail (default — chat-like dialog list + chat pane).
    // 1 = Calendar (week-grid with the calendar-list sidebar).
    // Wired to the left-rail icons; Rust side mirrors it for state
    // restoration.
    in-out property <int> view-mode: 0;
    // Burger menu (top-left) open state — replaces the old always-on nav rail.
    in-out property <bool> view-menu-open: false;
    // Connection lifecycle: any connections configured? and is the engine
    // currently rebuilding (after a connection change / at startup)?
    in property <bool> has-connections: false;
    in property <bool> engine-reloading: false;
    // Empty-state CTA → open settings to add the first connection.
    callback add-first-connection();

    // ── Address book (view-mode 2) ──
    in property <[AddrBookRow]> address-book;
    in-out property <string> contacts-query: "";
    // Fired (debounce-free; Rust throttles) as the user types the search box.
    callback contacts-search(string);
    // A row was clicked — Rust starts a compose to this address.
    callback contact-activated(string);

    // Contact editor overlay (create/edit). Rust fills the fields and toggles
    // `contact-editor-open`; save/delete dispatch to the engine.
    in-out property <bool> contact-editor-open: false;
    in-out property <bool> ce-is-edit: false; // show Delete + Написать
    // Account picker for CREATE (only shown with >1 connection).
    in property <[string]> ce-accounts;
    in-out property <int> ce-account-idx: 0;
    in-out property <string> ce-name;
    in-out property <string> ce-email;
    in-out property <string> ce-phone;
    in-out property <string> ce-org;
    callback contact-add();          // open blank editor
    callback contact-edit(int);      // open editor for row index
    callback contact-save();
    callback contact-delete();
    callback contact-editor-cancel();

    // ── Calendar state ──
    in property <[CalendarItem]> calendars;
    in property <[EventBlock]> events;
    // All-day chips for the band above the hour grid, plus how many rows
    // the band needs to stack same-day chips (0 = no band).
    in property <[AllDayBlock]> all-day-events;
    in property <int> all-day-rows: 0;
    in property <string> week-title: "";
    // The number of day columns we draw (5 or 7), and the width of one.
    in property <int> day-count: 7;
    in property <length> col-width: 300px;
    // Number of 24px dash segments per quarter-hour line (Rust sizes it to
    // the current grid width, capped for performance).
    in property <int> dash-count: 0;
    // True while we're waiting on the engine for events / calendars.
    // Drives a thin "Загрузка…" pill in the calendar topbar.
    in property <bool> calendar-loading: false;
    // Pixels per hour — UI uses this to position event blocks.
    in property <length> hour-height: 52px;
    // Range of hours shown vertically: [hour-start, hour-end).
    in property <int> hour-start: 0;
    in property <int> hour-end: 24;
    // Working-day window (local hours): outside [work-start, work-end) is
    // shaded as non-work.
    in property <int> work-start: 8;
    in property <int> work-end: 19;
    // Body viewport offset mirrored from the grid Flickable so the frozen
    // time gutter (vertical) and day-header row (horizontal) track scrolling.
    in-out property <length> grid-vp-x: 0;
    in-out property <length> grid-vp-y: 0;
    // Programmatic grid scroll (same pattern as chat-scroll-seq): Rust sets
    // grid-scroll-y (positive offset from the content top), raises pending
    // and bumps the seq. The seq bridge fires when the calendar pane is
    // already alive; pending covers the pane being instantiated right now —
    // the Flickable applies it on its first real layout. A plain binding
    // would be destroyed by the user's first manual scroll.
    in-out property <length> grid-scroll-y: 0;
    in-out property <int> grid-scroll-seq: 0;
    in-out property <bool> grid-scroll-pending: false;
    // Day-of-week labels Rust fills, parallel to the day columns.
    in property <[string]> day-headers;
    // Column index of "today" within the displayed week (-1 = not shown).
    in property <int> today-col: -1;
    // Current local time as fractional hours (e.g. 14.5) for the now-line.
    in property <float> now-hour: -1;
    // Aggregate connection light: 2 = green (all accounts connected),
    // 1 = yellow (some down), 0 = red (none). Drives the corner indicator.
    in property <int> conn-status: 2;
    // Список для выпадашки под точкой + её открытость.
    in property <[ConnDotRow]> conn-accounts;
    in-out property <bool> conn-menu-open: false;

    callback view-changed(int);
    callback calendar-prev();
    callback calendar-next();
    callback calendar-today();
    callback calendar-toggle-visibility(int);
    // Grid body on-screen size (drives the layout math in Rust).
    callback grid-area-resized(length, length);
    // Ctrl-wheel zoom (hours) / Ctrl-Alt-wheel zoom (day width). Arg = wheel
    // delta-y; sign chooses direction.
    callback calendar-zoom-hours(length);
    callback calendar-zoom-days(length);
    // Working-day start/end hours from the settings «Календарь» tab.
    callback set-work-hours(int, int);
    // (calendar id, palette index) from the colour-picker popup.
    callback calendar-set-color(int, int);
    callback event-clicked(int);
    // Double-click on empty grid → create an event at that day/time. Args:
    // click x, click y (viewport-content px), and the viewport width — Rust
    // turns them into a snapped start timestamp.
    callback grid-create-at(length, length, length);

    // ── Event drag-to-move (writable calendars only) ──
    // Drag state, set by the block's TouchArea; a ghost rectangle follows the
    // cursor while `cal-dragging`. On release the block reports its new grid
    // position and Rust converts px → new start/day → PatchEvent.
    in-out property <int> cal-drag-id: -1; // event id being dragged (-1 = none)
    in-out property <int> cal-drag-mode: 0; // 0 = move, 1 = resize-top, 2 = resize-bottom
    in-out property <bool> cal-dragging: false; // moved past the threshold
    in-out property <length> cal-drag-x0; // ghost origin (captured at press)
    in-out property <length> cal-drag-y0;
    in-out property <length> cal-drag-x; // live ghost top-left
    in-out property <length> cal-drag-y;
    in-out property <length> cal-drag-w;
    in-out property <length> cal-drag-h;
    in-out property <length> cal-drag-h0; // original height (resize keeps the far edge fixed)
    in-out property <string> cal-drag-title;
    in-out property <color> cal-drag-color;
    // (id, orig-x, orig-y, new-x, new-y) — all grid px. Rust snaps both to the
    // time grid + day column: orig gives the exact instance (recurrence_id for
    // recurring), new gives the target start. Then it patches the event.
    callback grid-event-moved(int, length, length, length, length);
    // Resize (id, orig-x, orig-y, new-top-y, new-bottom-y) — day unchanged;
    // new start = top edge, new end = bottom edge (grid px → snapped time).
    callback grid-event-resized(int, length, length, length, length);

    // Colour-picker popup state: which calendar's colour is being edited
    // (-1 = closed), plus the palette swatches mirrored from Rust.
    in-out property <int> color-picker-cal: -1;
    in property <[color]> cal-palette;

    // Event-detail popup (Phase B, read-only). Populated by the Rust side on
    // event-clicked; shown as a modal overlay.
    in-out property <bool> detail-visible: false;
    in property <string> detail-title;
    in property <string> detail-when;
    in property <string> detail-location;
    in property <string> detail-organizer;
    // Attendees table rows + my own PARTSTAT (highlights the pressed
    // RSVP button).
    in property <[AttRow]> detail-attendee-rows;
    in property <string> detail-my-partstat: "";
    in property <string> detail-description;
    // Status/recurrence/reminder line + every non-default event property
    // (conference link, URL, categories…) — see EventExtraItem.
    in property <string> detail-meta: "";
    in property <[EventExtraItem]> detail-extras;
    in-out property <int> detail-event-id;
    // Every URL found in the event's location/description (plain text
    // included) — rendered as clickable rows in the card.
    in property <[string]> detail-links;
    callback detail-open-link(string);
    callback detail-close();
    callback rsvp(int, string);
    callback detail-edit();
    callback detail-delete();

    // Event create/edit form (Phase B). Two-way bound to the Rust side.
    in-out property <bool> edit-visible: false;
    in property <bool> edit-is-create: true;
    in-out property <string> edit-title;
    // Дата/время начала и конца как числовые компоненты (заполняет и читает
    // Rust: open_*_form / save_edit_form). Заменили строку «YYYY-MM-DD HH:MM»
    // на пикер DateTimeField.
    in-out property <int> edit-s-year: 2026;
    in-out property <int> edit-s-month: 1;
    in-out property <int> edit-s-day: 1;
    in-out property <int> edit-s-hour: 0;
    in-out property <int> edit-s-min: 0;
    in-out property <int> edit-e-year: 2026;
    in-out property <int> edit-e-month: 1;
    in-out property <int> edit-e-day: 1;
    in-out property <int> edit-e-hour: 0;
    in-out property <int> edit-e-min: 0;
    in-out property <string> edit-location;
    in-out property <string> edit-description;
    in-out property <bool> edit-all-day: false;
    in property <[string]> edit-calendars;     // writable calendar names
    in-out property <int> edit-calendar-idx: 0;
    // Read-only block of the event card (meetings): organizer line,
    // attendees with participation-status dots, and a meta line
    // (cancelled/tentative · recurrence · reminder). All empty for
    // create mode and plain local events — the block collapses.
    in property <string> edit-organizer: "";
    in property <[AttendeeItem]> edit-attendees;
    in property <string> edit-meta: "";
    // Everything else the event carries that isn't a form field: conference
    // link, event URL, categories… Links open in the browser.
    in property <[EventExtraItem]> edit-extras;
    callback edit-open-url(string);
    callback edit-save();
    callback edit-cancel();
    callback new-event();

    callback select(int);
    // Объединение диалогов: правый клик по строке сайдбара. merge — клик
    // по строке при другом ОТКРЫТОМ диалоге (склеить с ним); unmerge —
    // разобрать склейку обратно.
    callback conv-merge(int);
    callback conv-unmerge(int);
    callback hit-test(int, length, length);
    // Hover query for the pointer cursor: true when (x, y) inside row
    // `idx` sits on a link rect. Pure — it's evaluated from a binding.
    pure callback hover-link(int, length, length) -> bool;
    // Text selection over the rendered bubbles (PDF-viewer style):
    // drag selects words, Ctrl+C copies. Rust owns the model; the UI
    // just renders the highlight rects for selection-row.
    in property <int> selection-row: -1;
    in property <[SelRect]> selection-rects;
    // Width (logical px) the current rows' link/text rects were extracted at.
    // While the column width drifts from it (resize-debounce window) the
    // bitmap is stretched horizontally by `image-fit: fill` — mouse x must be
    // mapped INTO this space before hit-testing, and highlight rects mapped
    // OUT of it, or clicks/highlights skew until the re-render lands.
    in property <length> body-rects-width: 740px;
    callback sel-start(int, length, length);
    callback sel-move(int, length, length);
    callback sel-end();
    callback copy-selection();
    callback viewport-resized(length);
    // Live chat-column width, assigned by the chat Rectangle's changed/init
    // handlers (its id is scoped inside a conditional branch, so a binding
    // can't reach it). Rust polls this to seed the first render width —
    // the assignment runs Slint-side even when the change event fires
    // before the Rust callback is registered.
    in-out property <length> chat-width: 0;
    // Programmatic chat scroll: Rust sets chat-scroll-y (positive offset
    // from the top) then bumps chat-scroll-seq; the bridge element next to
    // the ListView reacts to the seq change and assigns viewport-y. (A
    // plain binding would be destroyed by the user's first manual scroll.)
    in-out property <length> chat-scroll-y: 0;
    in-out property <int> chat-scroll-seq: 0;
    // True between a seq bump and the first post-layout re-apply: the
    // initial imperative assign happens BEFORE the ListView has laid out
    // the new rows (viewport-height is stale — often 0, the pane is
    // cleared on open), so the clamp kills the jump. The next
    // viewport-height change re-runs the assign once and drops the flag;
    // Rust also clears it on any scroll-less render as a belt.
    in-out property <bool> chat-scroll-pending: false;
    // Confirmation modal (delete conversation / spam-purge — the Rust side
    // dispatches by its own mode flag).
    // «Отвечаешь не с того адреса» — подтверждение перед отправкой, когда
    // выбранный отправитель не совпадает с адресом, на который пишут в этом
    // диалоге. Список адресов здесь текстовый, а не цветными кружками: в
    // момент, когда человек ошибся адресом, ему нужно прочитать адрес.
    in-out property <bool> from-mismatch-visible: false;
    // Адрес, на который пишут в диалоге, и адрес, с которого уйдёт письмо.
    in property <string> from-mismatch-expected;
    in property <string> from-mismatch-current;
    // Отправить как есть / отправить с выбранного адреса (индекс в
    // composer-identities) / отменить.
    // Адреса для выпадающего списка и текущий выбор в нём.
    in property <[string]> from-mismatch-options;
    in-out property <int> from-mismatch-index;
    callback from-mismatch-pick(int);
    // Композер очищает поле сразу при отправке, поэтому отмена обязана вернуть
    // текст обратно — иначе письмо просто исчезнет.
    callback from-mismatch-cancel();

    // Форматирование выделения в композере: (начало, конец, вид), смещения —
    // байтовые, как их отдаёт TextInput. Вид: 5 жирный, 6 курсив,
    // 7 подчёркнутый, 8 зачёркнутый — те же коды, что у резолвера клавиш.
    // Rust возвращает выделение на место после вставки маркеров. Через
    // свойства, а не функцию: id композера из корня не виден, а `changed`
    // внутри самого поля — виден.  `rev` нужен, чтобы повтор той же пары
    // смещений тоже срабатывал.

    in-out property <bool> confirm-delete-visible: false;
    in property <string> confirm-delete-title: "Удалить диалог?";
    in property <string> confirm-delete-text: "";
    // Spam mode: show «Адрес»/«Домен» blocking buttons instead of «Удалить».
    in property <bool> confirm-is-spam: false;
    callback delete-conversation();            // Delete key pressed
    callback delete-conversation-confirmed();  // user clicked the red button
    callback spam-confirmed(string);           // scope: "address" | "domain"
    // Header: identity tint + Tauri-era meta line + spam action.
    in property <brush> active-ident-color: white;
    in property <string> active-meta: "";
    callback spam-conversation();
    // Read-only source viewer («Показать → Заголовки / Исходник …»).
    in-out property <bool> source-view-visible: false;
    in property <string> source-view-title: "";
    in property <string> source-view-text: "";
    // When true the viewer shows the header name/value table (source-view-headers)
    // instead of the raw-text pane (source-view-text).
    in property <bool> source-view-is-headers: false;
    in property <[HeaderRow]> source-view-headers: [];
    // Source pane rendered as a bitmap (like a message bubble) so selection
    // reuses the fast text-run layer instead of Slint's slow TextInput.
    in property <image> source-img;
    in property <length> source-img-h;
    in property <[SelRect]> source-selection-rects: [];
    callback src-sel-start(length, length);
    callback src-sel-move(length, length);
    callback src-sel-end();
    callback src-copy-selection();
    // «Копировать всё» in the viewer — copies the raw source or the full
    // header block.
    callback source-view-copy();
    // Forward mode: explicit «Кому» recipients (composer panel).
    in-out property <string> composer-to: "";
    // Global «Медиа…» switches, mirrored from the Rust policy.
    in property <bool> media-allow-all-on: false;
    in property <bool> media-all-images-on: false;
    in property <bool> media-all-scripts-on: false;
    // Bump to pull keyboard focus into the «Кому» field (bridge inside
    // the composer panel scope — same pattern as chat-scroll-seq).
    in-out property <int> focus-to-seq: 0;
    // Arrow-key navigation over the conversation list: keep the selected
    // row visible (see the bridge next to the sidebar ListView).
    in-out property <length> sidebar-row-y: 0;
    in-out property <int> sidebar-scroll-seq: 0;
    callback nav-conversation(int); // -1 = вверх, +1 = вниз
    // Live chat-list scroll state, mirrored from the ListView so Rust can
    // answer "is the user at the bottom?" for new-mail behaviour.
    in-out property <length> chat-vp-y: 0;      // viewport-y (negative)
    in-out property <length> chat-vp-h: 0;      // content height
    in-out property <length> chat-view-h: 0;    // visible height
    // New-mail sound toggle (persisted client-side).
    in-out property <bool> notify-sound-on: true;
    callback toggle-notify-sound();
    // Snooze picker for calendar-reminder toasts («Напомнить позже»).
    in-out property <bool> snooze-visible: false;
    in property <string> snooze-summary: "";
    // Smart-step options, built per-event in Rust (only steps that land before
    // the start; «В момент начала» is a separate fixed button).
    in property <[SnoozeOpt]> snooze-options: [];
    callback snooze-choice(string); // option value: minutes ("5"/"30"/…) or "atstart"
    callback snooze-cancel();       // dialog dismissed WITHOUT a choice → resume the toast timer
    // ── Settings modal ──
    in-out property <bool> settings-visible: false;
    in-out property <int> settings-tab: 0; // 0 Уведомления · 1 Контент · 2 Подключение · 3 Аккаунты
    callback open-settings();
    // Connections list (Settings → Подключения) + CRUD callbacks.
    in property <[ConnRow]> connections;
    callback add-connection();
    callback edit-connection(int);
    callback delete-connection(int);
    // (legacy single-connection read-only props, still referenced elsewhere)
    in property <string> conn-account: "";
    in property <string> conn-mode: "";
    in property <string> conn-imap: "";
    in property <string> conn-smtp: "";
    in property <string> conn-native: "";
    // Global media policy (mirrors the per-message «Медиа…» allow-alls).
    callback set-media-global(string); // "allow-all" / "scripts-all" / "images-all"
    // ── Event hover tooltip (Tauri-era «HH:MM–HH:MM — summary») ──
    // No built-in tooltip in Slint, so a chip arms this on hover and a
    // short timer reveals a floating overlay rendered above the grid.
    property <bool> tip-armed: false;
    in-out property <bool> tip-visible: false;
    in-out property <string> tip-text: "";
    in-out property <length> tip-x: 0;
    in-out property <length> tip-y: 0;
    Timer {
        interval: 350ms;
        running: root.tip-armed && !root.tip-visible;
        triggered => {
            if (root.tip-armed) {
                root.tip-visible = true;
            }
        }
    }
    callback send(string);
    // Open the native file picker to stage attachments; remove one by index.
    callback attach-files();
    callback remove-attachment(int);
    callback msg-action(int, string);
    // Контекст вложения под правым кликом: перед показом меню Rust
    // хит-тестит точку (ctx-menu-probe) и заполняет ctx-attach-name;
    // пункты «Открыть/Сохранить вложение» видимы, пока имя непустое.
    callback ctx-menu-probe(int, length, length);
    in property <string> ctx-attach-name: "";
    callback open-attachment();
    callback save-attachment();
    // Live-dropdown wiring.
    callback search-typed(string);
    callback search-cleared();
    callback search-compose-new(string);
    callback search-select-contact(int);
    callback search-select-message(int);

    // Pull keyboard focus to the bottom-of-chat composer input. Used after
    // entering transient-compose mode so the user can immediately type.
    // Currently a no-op because `ti` lives inside the mail-view
    // conditional and isn't reachable from the root scope; revisit when
    // we split the mail layout into its own component.
    public function focus-composer() {
        // TODO: route via a forward-focus property once mail-view is a
        // dedicated component.
    }

    // Window-level key sink: Delete = delete the open conversation. 0×0 —
    // it only exists to hold keyboard focus; Rust re-grabs it via
    // grab-key-focus() after each conversation click, so typing in the
    // composer (which holds its own focus) keeps Delete as text editing.
    kb := FocusScope {
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(ev) => {
            // Source/headers viewer is modal: it owns the keyboard while open.
            if (root.source-view-visible) {
                if (Shortcuts.action(ev.text, ev.modifiers.control && !ev.modifiers.alt) == 1) {
                    root.src-copy-selection();
                    return accept;
                }
                if (ev.text == Key.Escape) {
                    root.source-view-visible = false;
                    return accept;
                }
                return accept;
            }
            if (ev.text == Key.Delete && !root.confirm-delete-visible) {
                root.delete-conversation();
                return accept;
            }
            // Ctrl+C — copy the bubble text selection. Matched on the control
            // code (ETX) rather than the letter: the code belongs to the key,
            // the letter to whatever layout happens to be active.
            if (Shortcuts.action(ev.text, ev.modifiers.control && !ev.modifiers.alt) == 1) {
                root.copy-selection();
                return accept;
            }
            // ↑/↓ — walk the conversation list (mail view only). Pairs
            // with Delete for the "курсором вниз, Delete, Delete" sweep.
            if (root.view-mode == 0 && ev.text == Key.UpArrow) {
                root.nav-conversation(-1);
                return accept;
            }
            if (root.view-mode == 0 && ev.text == Key.DownArrow) {
                root.nav-conversation(1);
                return accept;
            }
            reject
        }
    }
    public function grab-key-focus() { kb.focus(); }

    HorizontalLayout {
        spacing: 0px;

        // The old always-on nav rail was removed to reclaim horizontal
        // space; the view switcher now lives in a burger (☰) at each
        // sidebar's top-left, opening the menu overlay (view-menu-open).

        // ---------- Sidebar (mail view) ----------
        if root.view-mode == 0: Rectangle {
            width: root.sidebar-width;
            background: #f7f8fa;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    // Burger — opens the view-switcher menu (Почта/Календарь).
                    Rectangle {
                        x: 10px;
                        y: 10px;
                        width: 36px;
                        height: 36px;
                        border-radius: 10px;
                        background: burger-m.has-hover ? #e1e6ee : transparent;
                        burger-m := TouchArea { clicked => { root.view-menu-open = !root.view-menu-open; } }
                        // Drawn burger — the ☰ glyph is missing from the
                        // default font on Windows, so we draw three bars.
                        VerticalLayout {
                            padding-left: 9px;
                            padding-right: 9px;
                            spacing: 4px;
                            alignment: center;
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                        }
                    }
                    Rectangle {
                        x: 54px;
                        y: 10px;
                        width: parent.width - 64px;
                        height: 36px;
                        background: #eceef0;
                        border-radius: 18px;
                        si := KTextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            vertical-alignment: center;
                            color: #0f1419;
                            font-size: 14px;
                            single-line: true;
                            // Two-way binding to MainWindow.search-query so the
                            // Rust side can clear / pre-fill the input.
                            text <=> root.search-query;
                            edited => {
                                root.search-open = self.text != "";
                                root.search-selected-row = -1;
                                if (self.text == "") {
                                    root.search-cleared();
                                } else {
                                    root.search-typed(self.text);
                                }
                            }
                            extra-key-pressed(ev) => {
                                // Esc — close, keep text.
                                if (ev.text == Key.Escape) {
                                    root.search-open = false;
                                    root.search-selected-row = -1;
                                    return accept;
                                }
                                // ↓ — step into the dropdown or move down.
                                // Index math is inlined because Slint does not
                                // support local `:=` bindings inside callbacks.
                                if (ev.text == Key.DownArrow) {
                                    if (root.search-open
                                        && ((root.search-compose-email != "" ? 1 : 0)
                                            + root.search-contacts.length
                                            + root.search-messages.length) > 0) {
                                        root.search-selected-row =
                                            root.search-selected-row + 1
                                                >= (root.search-compose-email != "" ? 1 : 0)
                                                   + root.search-contacts.length
                                                   + root.search-messages.length
                                            ? (root.search-compose-email != "" ? 1 : 0)
                                              + root.search-contacts.length
                                              + root.search-messages.length - 1
                                            : root.search-selected-row + 1;
                                    }
                                    return accept;
                                }
                                // ↑ — move up, eventually returning to the input.
                                if (ev.text == Key.UpArrow) {
                                    root.search-selected-row = root.search-selected-row > 0
                                        ? root.search-selected-row - 1
                                        : -1;
                                    return accept;
                                }
                                // Enter — activate selected row, or compose-row
                                // when nothing's selected but the query is an
                                // email address.
                                if (ev.text == Key.Return) {
                                    // No row selected → fire compose-row if it's the
                                    // only thing in the dropdown.
                                    if (root.search-selected-row < 0) {
                                        if (root.search-compose-email != "") {
                                            root.search-compose-new(root.search-compose-email);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                    // compose-row at index 0 when visible
                                    if (root.search-compose-email != ""
                                        && root.search-selected-row == 0) {
                                        root.search-compose-new(root.search-compose-email);
                                        return accept;
                                    }
                                    // contacts segment: [cv .. cv+contacts.length)
                                    if (root.search-selected-row >= (root.search-compose-email != "" ? 1 : 0)
                                        && root.search-selected-row < (root.search-compose-email != "" ? 1 : 0)
                                                                     + root.search-contacts.length) {
                                        root.search-select-contact(
                                            root.search-selected-row - (root.search-compose-email != "" ? 1 : 0));
                                        return accept;
                                    }
                                    // messages segment: [cv+contacts.length .. end)
                                    if (root.search-selected-row >= (root.search-compose-email != "" ? 1 : 0)
                                                                   + root.search-contacts.length
                                        && root.search-selected-row < (root.search-compose-email != "" ? 1 : 0)
                                                                     + root.search-contacts.length
                                                                     + root.search-messages.length) {
                                        root.search-select-message(
                                            root.search-selected-row
                                            - (root.search-compose-email != "" ? 1 : 0)
                                            - root.search-contacts.length);
                                        return accept;
                                    }
                                    return reject;
                                }
                                return reject;
                            }
                        }
                        if si.text == "": Text {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            text: "Поиск или новый адресат…";
                            color: #8b95a1;
                            vertical-alignment: center;
                        }
                        if si.text != "": TouchArea {
                            x: parent.width - 30px;
                            y: 6px;
                            width: 24px;
                            height: 24px;
                            clicked => {
                                root.search-query = "";
                                root.search-open = false;
                                root.search-cleared();
                            }
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "×";
                                color: #8b95a1;
                                font-size: 18px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                conv-lv := ListView {
                    for conv[idx] in root.conversations: Rectangle {
                        height: 64px;
                        // Identity tint on idle rows (Tauri-era behaviour):
                        // selection and hover override it.
                        background: idx == root.selected ? #10b981
                            : conv-ta.has-hover ? #e8ecf1
                            : conv.ident-color;
                        // New-mail flash: pops on instantly, fades out over
                        // a second once Rust clears the flag.
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            background: #10b9814d;
                            opacity: conv.highlight ? 1.0 : 0.0;
                            animate opacity { duration: 900ms; easing: ease-out; }
                        }
                        conv-cm := ContextMenuArea {
                            width: 100%;
                            height: 100%;
                            Menu {
                                MenuItem {
                                    title: "Объединить с открытым диалогом";
                                    enabled: idx != root.selected;
                                    activated => { root.conv-merge(idx); }
                                }
                                if conv.is-merged: MenuItem {
                                    title: "Разъединить диалоги";
                                    activated => { root.conv-unmerge(idx); }
                                }
                            }
                            Rectangle { }
                        }
                        conv-ta := TouchArea {
                            clicked => { root.select(idx); }
                            // Правый клик — меню объединения диалогов; TouchArea
                            // перехватывает pointer-события, так что показываем
                            // ContextMenuArea вручную (как у пузырей).
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right
                                    && e.kind == PointerEventKind.down) {
                                    conv-cm.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                        HorizontalLayout {
                            padding: 9px;
                            spacing: 12px;
                            Rectangle {
                                width: 46px;
                                height: 46px;
                                border-radius: 23px;
                                background: conv.color;
                                clip: true;
                                if !conv.has-avatar: Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: conv.initials;
                                    color: white;
                                    font-weight: 700;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if conv.has-avatar: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: conv.avatar;
                                    image-fit: cover;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: conv.name;
                                    font-weight: 700;
                                    font-size: 15px;
                                    color: idx == root.selected ? white : #0f1419;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                                Text {
                                    text: conv.preview;
                                    font-size: 13px;
                                    color: idx == root.selected ? #e8f0fe : #8b95a1;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                            }
                            // Unread pill (Tauri-era): blue with white
                            // count; inverted on the selected row.
                            if conv.unread > 0: VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: max(18px, ub-t.preferred-width + 12px);
                                    height: 18px;
                                    border-radius: 9px;
                                    background: idx == root.selected ? white : #10b981;
                                    ub-t := Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: conv.unread;
                                        color: idx == root.selected ? #10b981 : white;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
                // Scroll bridge: arrow-key navigation bumps the seq and the
                // handler nudges viewport-y just enough to keep the selected
                // row (sidebar-row-y, 64px tall) fully visible.
                Rectangle {
                    visible: false;
                    width: 0;
                    height: 0;
                    x: root.sidebar-scroll-seq * 1px;
                    changed x => {
                        if (root.sidebar-row-y < -conv-lv.viewport-y) {
                            conv-lv.viewport-y = -root.sidebar-row-y;
                        } else if (root.sidebar-row-y + 64px > -conv-lv.viewport-y + conv-lv.height) {
                            conv-lv.viewport-y = -(root.sidebar-row-y + 64px - conv-lv.height);
                        }
                    }
                }
            }

            // ---------- Search dropdown (overlay) ----------
            // Lives inside `sidebar` as a sibling of the VerticalLayout so
            // it renders on top of the conversation list. Visibility is
            // driven by `search-open` (set true on text-edited, false on
            // clear / Escape / explicit close).
            if root.search-open: Rectangle {
                x: 10px;
                y: 50px;
                width: parent.width - 20px;
                height: min(420px, body.preferred-height);
                background: white;
                border-color: #d8dde6;
                border-width: 1px;
                border-radius: 10px;
                drop-shadow-blur: 18px;
                drop-shadow-color: #00000022;
                drop-shadow-offset-y: 4px;

                body := VerticalLayout {
                    padding: 4px;

                    // "Написать xxx@yyy" — appears when the typed text
                    // parses as an email AND nothing more specific has been
                    // selected. Rust side computes the regex.
                    if root.search-compose-email != "": Rectangle {
                        height: 40px;
                        background: (root.search-selected-row == 0 || cn-ta.has-hover) ? #e6efff : transparent;
                        border-radius: 8px;
                        cn-ta := TouchArea {
                            clicked => { root.search-compose-new(root.search-compose-email); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: start;
                            Text {
                                width: 18px;
                                text: "✎";
                                color: #10b981;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "Написать по адресу: " + root.search-compose-email;
                                color: #10b981;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // Loading / empty / sections
                    if root.search-loading && root.search-contacts.length == 0 && root.search-messages.length == 0
                        && root.search-compose-email == "": Text {
                        height: 32px;
                        text: "Ищу…";
                        color: #8b95a1;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !root.search-loading
                        && root.search-contacts.length == 0
                        && root.search-messages.length == 0
                        && root.search-compose-email == "": Text {
                        height: 32px;
                        text: "Ничего не найдено";
                        color: #8b95a1;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Contacts section
                    if root.search-contacts.length > 0: Rectangle {
                        height: 22px;
                        Text {
                            x: 12px;
                            text: "КОНТАКТЫ";
                            color: #8b95a1;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                    for c[ci] in root.search-contacts: Rectangle {
                        height: 44px;
                        background: (root.search-selected-row == (root.search-compose-email != "" ? 1 : 0) + ci
                                     || c-ta.has-hover) ? #e6efff : transparent;
                        border-radius: 8px;
                        c-ta := TouchArea {
                            clicked => { root.search-select-contact(ci); }
                        }
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            alignment: center;
                            Text {
                                text: c.name == "" ? c.email : c.name;
                                color: #0f1419;
                                font-size: 14px;
                                font-weight: 500;
                                overflow: elide;
                            }
                            if c.name != "": Text {
                                text: c.email;
                                color: #8b95a1;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }

                    // Messages section
                    if root.search-messages.length > 0: Rectangle {
                        height: 22px;
                        Text {
                            x: 12px;
                            text: "СООБЩЕНИЯ";
                            color: #8b95a1;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                            vertical-alignment: center;
                        }
                    }
                    for m[mi] in root.search-messages: Rectangle {
                        height: 50px;
                        background: (root.search-selected-row == (root.search-compose-email != "" ? 1 : 0)
                                                                 + root.search-contacts.length + mi
                                     || m-ta.has-hover) ? #e6efff : transparent;
                        border-radius: 8px;
                        m-ta := TouchArea {
                            clicked => { root.search-select-message(mi); }
                        }
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            alignment: center;
                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: m.from;
                                    color: #0f1419;
                                    font-size: 14px;
                                    font-weight: 500;
                                    overflow: elide;
                                }
                                Text {
                                    text: m.date;
                                    color: #8b95a1;
                                    font-size: 12px;
                                }
                            }
                            Text {
                                text: m.subject == "" ? "(без темы)" : m.subject;
                                color: #8b95a1;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // ---------- Splitter (mail view) ----------
        //
        // Draggable handle between the sidebar and the chat pane.
        // The trick: each `moved` event applies the cursor's offset
        // from the handle's centre as a delta to `sidebar-width`. Once
        // the layout reflows, the handle follows the cursor and the
        // delta tends back to zero — effectively tracking absolute
        // mouse motion with at most a few pixels of "wobble" equal to
        // the handle width.
        if root.view-mode == 0: Rectangle {
            width: 4px;
            background: spl-ta.has-hover || spl-ta.pressed ? #d2dbe4 : #e6ecf2;
            spl-ta := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    if (self.pressed) {
                        root.sidebar-width = max(180px, min(640px,
                            root.sidebar-width + self.mouse-x - 2px));
                    }
                }
            }
        }

        // ---------- Main (mail view) ----------
        if root.view-mode == 0: VerticalLayout {
            Rectangle {
                height: 60px;
                // Same identity tint as the conversation's sidebar row.
                background: root.active-ident-color;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.active-color;
                        clip: true;
                        if !root.active-has-avatar: Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.active-initials;
                            color: white;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.active-has-avatar: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.active-avatar;
                            image-fit: cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.active-name;
                            color: #0f1419;
                            font-weight: 700;
                            font-size: 16px;
                            overflow: elide;
                        }
                        // Tauri-era meta: counterpart address (or group
                        // participants) + " → receiving identity".
                        Text {
                            text: root.active-meta;
                            color: #69737e;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    // «Спам»: blacklist the counterpart + purge all their
                    // mail (with confirmation) — restored from Tauri.
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: spam-ta.has-hover ? #fbe3e5 : transparent;
                        Rectangle {
                            x: 8px; y: 8px;
                            width: 20px; height: 20px;
                            border-radius: 10px;
                            border-width: 2px;
                            border-color: spam-ta.has-hover ? #e8616a : #8b95a1;
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 20;
                                viewbox-height: 20;
                                stroke: spam-ta.has-hover ? #e8616a : #8b95a1;
                                stroke-width: 2px;
                                MoveTo { x: 5.5; y: 14.5; }
                                LineTo { x: 14.5; y: 5.5; }
                            }
                        }
                        spam-ta := TouchArea {
                            clicked => { root.spam-conversation(); }
                        }
                    }
                }
            }

            chat-area := Rectangle {
                vertical-stretch: 1;
                background: #e9eef5;
                // Tell Rust the chat width so Blitz re-renders rows to fill it.
                // Also mirror it into root.chat-width: the change event can
                // fire during setup BEFORE Rust registers the callback, and
                // the initial layout pass may not fire it at all — the
                // Rust-side watcher polls the mirrored value to recover.
                init => { root.chat-width = self.width; }
                changed width => {
                    root.chat-width = self.width;
                    root.viewport-resized(self.width);
                }

                // Thin loader bar overlaid at the top while Ultralight is
                // still chewing through the conversation's bubbles. Becomes
                // invisible the moment progress catches up with total.
                if root.render-total > 0 && root.render-progress < root.render-total: bar := Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 28px;
                    background: #10b98111;
                    border-color: #10b98144;
                    border-width: 0px;
                    z: 10;
                    // Keep the sliding indeterminate segment inside the chat
                    // pane — without this its negative-x start bleeds left
                    // across the conversation sidebar.
                    clip: true;

                    // progress == 0 means the bodies are still being fetched
                    // over the network — nothing has rendered yet. Show a
                    // moving segment so the bar never looks frozen at "0 из N".
                    // Flips to a real proportional fill the moment the render
                    // worker starts ticking bodies off.
                    property <bool> indeterminate: root.render-progress <= 0;
                    property <float> phase: 0;

                    Timer {
                        interval: 33ms;
                        running: bar.indeterminate;
                        triggered => {
                            bar.phase = bar.phase + 0.018;
                            if (bar.phase >= 1) {
                                bar.phase = 0;
                            }
                        }
                    }

                    // Determinate fill — proportional (rendering in progress).
                    if !bar.indeterminate: Rectangle {
                        x: 0;
                        y: parent.height - 3px;
                        width: parent.width * (root.render-total > 0
                            ? root.render-progress / root.render-total
                            : 0);
                        height: 3px;
                        background: #10b981;
                    }
                    // Indeterminate — a segment sliding left-to-right while the
                    // fetch is in flight.
                    if bar.indeterminate: Rectangle {
                        y: parent.height - 3px;
                        width: parent.width * 0.3;
                        x: (parent.width * 1.3) * bar.phase - parent.width * 0.3;
                        height: 3px;
                        background: #10b981;
                    }
                    Text {
                        width: parent.width;
                        height: parent.height - 3px;
                        text: bar.indeterminate
                            ? "Загружаю письма…"
                            : "Загружаю " + root.render-progress + " из " + root.render-total + "…";
                        color: #10b981;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // Programmatic scroll bridge: reacts to chat-scroll-seq bumps
                // from Rust and assigns lv.viewport-y imperatively (clamped
                // to the content range). Invisible, zero-size — children of a
                // plain Rectangle are absolutely positioned, so it doesn't
                // affect layout.
                Rectangle {
                    visible: false;
                    width: 0;
                    height: 0;
                    x: root.chat-scroll-seq * 1px;
                    changed x => {
                        root.chat-scroll-pending = true;
                        lv.viewport-y = -max(0px, min(root.chat-scroll-y,
                            lv.viewport-height - lv.height));
                    }
                }
                lv := ListView {
                    // Mirror scroll state for the Rust-side "at bottom?" check
                    // (new-mail append behaviour).
                    changed viewport-y => { root.chat-vp-y = self.viewport-y; }
                    changed viewport-height => {
                        root.chat-vp-h = self.viewport-height;
                        // Re-run the pending post-open jump now that the rows
                        // are actually laid out — ONCE. The flag must drop
                        // here: the lazy ListView keeps adjusting
                        // viewport-height while the user scrolls, and a
                        // sticky flag re-yanks the view on every tick,
                        // making it impossible to scroll away.
                        if (root.chat-scroll-pending) {
                            root.chat-scroll-pending = false;
                            lv.viewport-y = -max(0px, min(root.chat-scroll-y,
                                lv.viewport-height - lv.height));
                        }
                    }
                    changed height => { root.chat-view-h = self.height; }
                    for msg[idx] in root.messages: Rectangle {
                        height: msg.h;
                        cma := ContextMenuArea {
                            Menu {
                                // Вложение под курсором (ctx-menu-probe перед
                                // show): открыть — как левый клик по чипу;
                                // сохранить — диалог «Сохранить как…».
                                if root.ctx-attach-name != "": MenuItem {
                                    title: "Открыть «" + root.ctx-attach-name + "»";
                                    activated => { root.open-attachment(); }
                                }
                                if root.ctx-attach-name != "": MenuItem {
                                    title: "Сохранить «" + root.ctx-attach-name + "»…";
                                    activated => { root.save-attachment(); }
                                }
                                if root.ctx-attach-name != "": MenuSeparator { }
                                MenuItem { title: "Ответить"; activated => { root.msg-action(idx, "reply"); } }
                                MenuItem { title: "Переслать"; activated => { root.msg-action(idx, "forward"); } }
                                MenuItem { title: "Копировать текст"; activated => { root.msg-action(idx, "copy"); } }
                                MenuSeparator { }
                                Menu {
                                    title: "Показать…";
                                    MenuItem { title: "Заголовки"; activated => { root.msg-action(idx, "show-headers"); } }
                                    MenuItem { title: "Исходник сообщения"; activated => { root.msg-action(idx, "show-source"); } }
                                    if msg.has-html && msg.viewing-html: MenuItem {
                                        title: "Исходник тела (HTML)";
                                        activated => { root.msg-action(idx, "show-body-source"); }
                                    }
                                    if msg.has-text && msg.viewing-html: MenuItem {
                                        title: "Текстовую версию";
                                        activated => { root.msg-action(idx, "view-text"); }
                                    }
                                    if msg.has-html && !msg.viewing-html: MenuItem {
                                        title: "HTML-версию";
                                        activated => { root.msg-action(idx, "view-html"); }
                                    }
                                }
                                Menu {
                                    title: "Медиа…";
                                    MenuItem {
                                        title: (root.media-allow-all-on ? "✓ " : "") + "Разрешить всё";
                                        activated => { root.msg-action(idx, "media-allow-all"); }
                                    }
                                    Menu {
                                        title: "Скрипты…";
                                        enabled: !root.media-allow-all-on;
                                        MenuItem {
                                            title: (root.media-all-scripts-on ? "✓ " : "") + "Разрешить все";
                                            activated => { root.msg-action(idx, "media-scripts-all"); }
                                        }
                                        MenuItem {
                                            title: (msg.s-sender-on ? "✓ " : "") + "Разрешить все от " + msg.sender;
                                            enabled: !root.media-all-scripts-on;
                                            activated => { root.msg-action(idx, "media-scripts-sender"); }
                                        }
                                        if msg.script-host != "": MenuItem {
                                            title: (msg.s-host-on ? "✓ " : "") + "Разрешить все для " + msg.script-host;
                                            enabled: !root.media-all-scripts-on;
                                            activated => { root.msg-action(idx, "media-scripts-host"); }
                                        }
                                    }
                                    Menu {
                                        title: "Изображения…";
                                        enabled: !root.media-allow-all-on;
                                        MenuItem {
                                            title: (root.media-all-images-on ? "✓ " : "") + "Разрешить все";
                                            activated => { root.msg-action(idx, "media-images-all"); }
                                        }
                                        MenuItem {
                                            title: (msg.m-sender-on ? "✓ " : "") + "Разрешить все от " + msg.sender;
                                            enabled: !root.media-all-images-on;
                                            activated => { root.msg-action(idx, "media-images-sender"); }
                                        }
                                        if msg.media-host != "": MenuItem {
                                            title: (msg.m-host-on ? "✓ " : "") + "Разрешить все для " + msg.media-host;
                                            enabled: !root.media-all-images-on;
                                            activated => { root.msg-action(idx, "media-images-host"); }
                                        }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem { title: "Удалить"; activated => { root.msg-action(idx, "delete"); } }
                            }
                            Image {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: msg.h;
                                source: msg.img;
                                // `fill` (not contain) so the bubble maps linearly
                                // onto the bitmap with no letterbox — keeps click
                                // (x,y) aligned with the extracted link rects.
                                image-fit: fill;
                                image-rendering: smooth;
                            }
                        }
                        // Selection highlight — merged per-line rects over
                        // the texture, computed Rust-side. Plain Rectangles:
                        // they don't intercept pointer events.
                        if idx == root.selection-row: selov := Rectangle {
                            width: parent.width;
                            height: msg.h;
                            // rect-space → widget-space (x only: the bitmap
                            // height is displayed 1:1, width may be stretched).
                            property <float> fx: self.width / max(1px, root.body-rects-width);
                            for sr in root.selection-rects: Rectangle {
                                x: sr.x * selov.fx;
                                y: sr.y;
                                width: sr.w * selov.fx;
                                height: sr.h;
                                background: #10b9813d;
                                border-radius: 2px;
                            }
                        }
                        // Whole-bubble pointer handling: left click → hit-test in
                        // Blitz for a link; right click → open the native menu;
                        // left drag → text selection (Ctrl+C copies).
                        // The cursor flips to a pointer over link rects so it's
                        // obvious a click opens the browser.
                        TouchArea {
                            width: parent.width;
                            height: msg.h;
                            // widget-space → rect-space for the mouse x (see
                            // body-rects-width); y is already 1:1.
                            property <float> fx: root.body-rects-width / max(1px, self.width);
                            mouse-cursor: self.has-hover
                                && root.hover-link(idx, self.mouse-x * self.fx, self.mouse-y)
                                ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { root.hit-test(idx, self.mouse-x * self.fx, self.mouse-y); }
                            moved => {
                                if (self.pressed) {
                                    root.sel-move(idx, self.mouse-x * self.fx, self.mouse-y);
                                }
                            }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right
                                    && e.kind == PointerEventKind.down) {
                                    // Сначала хит-тест точки: если под курсором
                                    // чип вложения, меню получит его пункты.
                                    root.ctx-menu-probe(idx, self.mouse-x * self.fx, self.mouse-y);
                                    cma.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                                if (e.button == PointerEventButton.left) {
                                    if (e.kind == PointerEventKind.down) {
                                        root.sel-start(idx, self.mouse-x * self.fx, self.mouse-y);
                                    } else if (e.kind == PointerEventKind.up) {
                                        root.sel-end();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Composer header — Subject + Cc fields, hidden by default.
            // Toggled by the chevron button next to the input. Auto-
            // derived values appear as placeholders, so leaving them
            // empty falls back to the auto behaviour at send time.
            if root.composer-expanded: Rectangle {
                height: 112px;
                background: white;
                // Focus bridge: Rust bumps focus-to-seq → grab the «Кому»
                // input (its id is scoped here, unreachable from root).
                Rectangle {
                    visible: false;
                    width: 0; height: 0;
                    x: root.focus-to-seq * 1px;
                    changed x => { si-to.focus(); }
                }
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 6px;
                    padding-bottom: 4px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 50px;
                            text: "Кому:";
                            color: #8b95a1;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #f0f2f5;
                            border-radius: 8px;
                            height: 30px;
                            si-to := KTextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: #0f1419;
                                font-size: 13px;
                                single-line: true;
                                text <=> root.composer-to;
                            }
                            if si-to.text == "": Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: root.composer-to-auto != ""
                                    ? root.composer-to-auto
                                    : "(текущий диалог)";
                                color: #b5bcc6;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 50px;
                            text: "Тема:";
                            color: #8b95a1;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #f0f2f5;
                            border-radius: 8px;
                            height: 30px;
                            si-subj := KTextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: #0f1419;
                                font-size: 13px;
                                single-line: true;
                                text <=> root.composer-subject;
                            }
                            if si-subj.text == "": Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: root.composer-subject-auto != ""
                                    ? root.composer-subject-auto
                                    : "(тема не указана)";
                                color: #b5bcc6;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: 50px;
                            text: "Cc:";
                            color: #8b95a1;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: #f0f2f5;
                            border-radius: 8px;
                            height: 30px;
                            si-cc := KTextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: #0f1419;
                                font-size: 13px;
                                single-line: true;
                                text <=> root.composer-cc;
                            }
                            if si-cc.text == "": Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: "address1@…, address2@…";
                                color: #b5bcc6;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Telegram-style reply ribbon — only visible when the user
            // hit "Ответить" on a specific bubble. Cancellable via ×;
            // also implicitly cancelled by Send.
            if root.reply-ribbon-visible: Rectangle {
                height: 50px;
                background: white;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 10px;
                    Rectangle {
                        width: 3px;
                        background: #10b981;
                        border-radius: 1px;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.reply-ribbon-from;
                            font-size: 12px;
                            font-weight: 700;
                            color: #10b981;
                            overflow: elide;
                        }
                        Text {
                            text: root.reply-ribbon-preview;
                            font-size: 13px;
                            color: #5f6770;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: rx-ta.has-hover ? #f0f2f5 : transparent;
                        rx-ta := TouchArea {
                            clicked => { root.reply-ribbon-cancel(); }
                        }
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "×";
                            color: #8b95a1;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Staged-attachment chips, shown above the input while files
            // are queued for the next message. Each chip removes itself via ×.
            if root.composer-attachments.length > 0: Rectangle {
                height: 36px;
                background: white;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 6px;
                    alignment: start;
                    for a[ai] in root.composer-attachments: Rectangle {
                        height: 28px;
                        background: #eef3fb;
                        border-radius: 14px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 2px;
                            Text {
                                text: a.name;
                                color: #10b981;
                                font-size: 12px;
                                font-weight: 600;
                                max-width: 170px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: 20px;
                                rm-ta := TouchArea { clicked => { root.remove-attachment(ai); } }
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "×";
                                    color: rm-ta.has-hover ? #e23b3b : #8b95a1;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Панель форматирования: показывается, только когда композер в
            // фокусе — в покое пузырь остаётся телеграмно-чистым. Ж/К/Ч
            // дублируют Ctrl+B/I/U (те работают в любой раскладке).
            if root.composer-format-bar-visible: Rectangle {
                height: 30px;
                background: white;
                HorizontalLayout {
                    padding-left: 66px;
                    spacing: 4px;
                    alignment: start;
                    for b[i] in [
                        { label: "Ж", weight: 800, italic: false, hint: "Полужирный (Ctrl+B)" },
                        { label: "К", weight: 500, italic: true, hint: "Курсив (Ctrl+I)" },
                        { label: "Ч", weight: 500, italic: false, hint: "Подчёркнутый (Ctrl+U)" },
                    ]: Rectangle {
                        property <bool> active: i == 0 ? root.rt-bold
                            : (i == 1 ? root.rt-italic : root.rt-underline);
                        width: 26px;
                        height: 26px;
                        border-radius: 6px;
                        background: active ? #d7f2e8 : (fmt-ta.has-hover ? #eef0f4 : transparent);
                        fmt-ta := TouchArea {
                            // Кнопку жмём, фокус остаётся в тексте: тулбар не
                            // забирает его на себя (иначе выделение слетало бы).
                            clicked => { root.rt-toggle(i); }
                        }
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: b.label;
                            font-size: 14px;
                            font-weight: parent.active ? 800 : b.weight;
                            font-italic: b.italic;
                            color: parent.active ? #0b8f66 : #5b6672;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        // Подчёркивание рисуем сами: font-underline у Slint нет.
                        if i == 2: Rectangle {
                            x: 8px;
                            y: 18px;
                            width: 10px;
                            height: 1px;
                            background: parent.active ? #0b8f66 : #5b6672;
                        }
                    }
                }
            }

            Rectangle {
                // Grows with the message up to a cap: Shift+Enter adds a
                // newline, Enter sends. Single-line messages stay at 64px.
                min-height: 64px;
                // Десять строк, дальше — скролл внутри пузыря (Flickable ниже
                // уже это умеет). 15px кегль даёт строку около 21px, плюс
                // 16px вертикальных отступов пузыря и запас на отступы строки.
                max-height: 10 * 21px + 32px;
                background: white;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    // From-picker — the identity the next message goes out as.
                    // Coloured dot mirrors the sidebar tint; click opens the
                    // list (rendered as a floating panel above the composer).
                    if root.composer-identities.length > 1: Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: ident-ta.has-hover || root.identity-menu-open
                            ? #eef0f4 : transparent;
                        ident-ta := TouchArea {
                            clicked => { root.identity-menu-open = !root.identity-menu-open; }
                        }
                        Rectangle {
                            x: 12px;
                            y: 15px;
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: root.composer-identity-index >= 0
                                && root.composer-identity-index < root.composer-identities.length
                                ? root.composer-identities[root.composer-identity-index].tint
                                : #8b95a1;
                        }
                        Text {
                            x: 27px;
                            height: parent.height;
                            text: "▾";
                            color: #8b95a1;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    // Attach files — opens the native picker. Drawn paperclip
                    // (the 📎 emoji has no glyph in the default font — same
                    // story as the burger / chevron above, which are Paths).
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: att-ta.has-hover ? #eef0f4 : transparent;
                        att-ta := TouchArea { clicked => { root.attach-files(); } }
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 22px;
                            height: 22px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            // Lucide "paperclip" — an open stroked outline
                            // (fill-rule for the closed bootstrap glyph isn't
                            // reliable in Slint, so it filled solid).
                            commands: "M 21.44 11.05 L 12.25 20.24 A 6 6 0 0 1 3.76 11.75 L 12.33 3.18 A 4 4 0 0 1 18 8.84 L 9.41 17.41 A 2 2 0 0 1 6.58 14.58 L 15.07 6.1";
                            stroke: att-ta.has-hover ? #4b5563 : #8b95a1;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                    }
                    // Rich-text пузырь: битмап от Rust + каретка поверх.
                    // Пузырь растёт вместе с содержимым (preferred-height
                    // пробрасывает высоту в строку композера, капы min/max
                    // задаёт родительская строка). Когда кап достигнут,
                    // содержимое прокручивается во Flickable — каретка всегда
                    // остаётся в видимой области, clip не даёт рисоваться за
                    // пределами пузыря.
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #f0f2f5;
                        border-radius: 20px;
                        preferred-height: root.rt-height + 16px;
                        clip: true;
                        // Фокус-скоуп идёт ПЕРВЫМ и на всю площадь пузыря:
                        // так он лежит под содержимым (клики достаются
                        // TouchArea выше), но при этом имеет геометрию —
                        // нулевой по размеру элемент фокус не берёт.
                        rt-scope := FocusScope {
                            changed has-focus => { root.rt-focus-changed(self.has-focus); }
                            key-pressed(ev) => {
                                // Разбор — целиком в Rust: там и модель, и
                                // раскладко-независимые шорткаты, и буфер обмена.
                                return root.rt-key(ev.text, ev.modifiers.control,
                                    ev.modifiers.shift, ev.modifiers.alt)
                                    ? EventResult.accept : EventResult.reject;
                            }
                        }
                        fli := Flickable {
                            x: 16px;
                            y: 8px;
                            width: parent.width - 32px;
                            height: parent.height - 16px;
                            // Драг-флик выключен: перетаскивание мышью — это
                            // выделение текста, не прокрутка. Скролл едет за
                            // кареткой (changed rt-caret-y ниже).
                            interactive: false;
                            viewport-width: self.width;
                            viewport-height: max(self.height, root.rt-height);
                            // Ширина колонки — единственный вход вёрстки со
                            // стороны Slint: поменялась (ресайз окна, шеврон) —
                            // Rust переверстает и пришлёт новый битмап. `init`
                            // отдаёт стартовую ширину: без неё первый кадр
                            // рисовать не по чему и композер остался бы пустым.
                            init => { root.rt-resize(self.width); }
                            changed width => { root.rt-resize(self.width); }
                            Image {
                                x: 0;
                                y: 0;
                                width: fli.viewport-width;
                                height: root.rt-height;
                                source: root.rt-image;
                                // fill + 1:1 логический размер: битмап уже
                                // отрисован в физических пикселях окна, любое
                                // масштабирование здесь мылило бы текст.
                                image-fit: fill;
                                image-rendering: smooth;
                            }
                            // Каретка. Мигает только когда поле в фокусе и нет
                            // выделения — при выделении курсор в текстовых
                            // полях не мигает нигде.
                            if rt-scope.has-focus && !root.rt-has-selection: Rectangle {
                                x: root.rt-caret-x;
                                y: root.rt-caret-y;
                                width: 2px;
                                height: root.rt-caret-h;
                                background: #10b981;
                                opacity: blink.on ? 1.0 : 0.0;
                            }
                            TouchArea {
                                width: fli.viewport-width;
                                height: fli.viewport-height;
                                pointer-event(e) => {
                                    if (e.button != PointerEventButton.left) { return; }
                                    if (e.kind == PointerEventKind.down) {
                                        rt-scope.focus();
                                        root.rt-pointer(self.mouse-x, self.mouse-y, 0);
                                    } else if (e.kind == PointerEventKind.up) {
                                        root.rt-pointer(self.mouse-x, self.mouse-y, 2);
                                    }
                                }
                                // Двойной клик — выделить слово (приходит
                                // ПОСЛЕ down, поэтому просто переопределяет
                                // выделение, поставленное кликом).
                                double-clicked => {
                                    root.rt-pointer(self.mouse-x, self.mouse-y, 3);
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.rt-pointer(self.mouse-x, self.mouse-y, 1);
                                    }
                                }
                            }
                        }
                        // Фазу мигания держим здесь, а не в Rust: перерисовка
                        // битмапа ради курсора — расточительство.
                        blink := Timer {
                            interval: 530ms;
                            running: rt-scope.has-focus;
                            property <bool> on: true;
                            triggered => { self.on = !self.on; }
                        }
                        // Скролл едет за кареткой: ушла под край — подвозим
                        // вьюпорт, финальный clamp держит его в диапазоне и
                        // после удаления строк. `changed` умеет следить только
                        // за свойством своего элемента — отсюда локальное
                        // зеркало каретки.
                        property <length> caret-y: root.rt-caret-y;
                        changed caret-y => {
                            if (self.caret-y + root.rt-caret-h > fli.height - fli.viewport-y) {
                                fli.viewport-y = -(self.caret-y + root.rt-caret-h - fli.height);
                            }
                            if (self.caret-y < -fli.viewport-y) {
                                fli.viewport-y = -self.caret-y;
                            }
                            fli.viewport-y = max(fli.height - fli.viewport-height,
                                min(0px, fli.viewport-y));
                        }
                        if root.rt-empty: Text {
                            x: 16px;
                            width: parent.width - 32px;
                            height: parent.height;
                            text: "Написать сообщение…";
                            color: #8b95a1;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: #10b981;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "→";
                            color: white;
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                // Текст берём из зеркала rich-документа; сам
                                // документ (стиль, картинки) читает Rust в
                                // on_send. Очистка — тоже там, только на
                                // успешной ветке.
                                if (root.rt-can-send) { root.send(root.composer-text); }
                            }
                        }
                    }
                    // Chevron toggle — reveals the subject + cc panel.
                    // Placed last so it sits at the right edge, after send.
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: chv-ta.has-hover ? #eef0f4 : transparent;
                        chv-ta := TouchArea {
                            clicked => { root.composer-expanded = !root.composer-expanded; }
                        }
                        // Drawn chevron — the ⌃/⌄ glyphs are missing from the
                        // default font on Windows (same story as the burger).
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 7px;
                            commands: root.composer-expanded ? "M 0 7 L 6 0 L 12 7" : "M 0 0 L 6 7 L 12 0";
                            stroke: #6b7480;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                    }
                }
                // Inline «✓ Отправлено» — floats above the composer for ~2s
                // after the server acks a send (subtle confirmation, no
                // toasts). Negative y: Rectangles don't clip children.
                Rectangle {
                    x: parent.width - self.width - 20px;
                    y: -38px;
                    width: send-confirm-label.preferred-width + 26px;
                    height: 30px;
                    border-radius: 15px;
                    background: #10b981;
                    opacity: root.send-confirm-visible ? 0.95 : 0;
                    animate opacity { duration: 250ms; }
                    send-confirm-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.send-confirm-text;
                        color: white;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // From-picker list — floats above the composer (negative y;
                // Rectangles don't clip children). Later sibling of the
                // input row, so it paints over the bubble list.
                if root.identity-menu-open: Rectangle {
                    x: 12px;
                    y: -self.height - 6px;
                    width: 340px;
                    height: root.composer-identities.length * 36px + 8px;
                    background: white;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #e3e6ea;
                    drop-shadow-blur: 14px;
                    drop-shadow-color: #00000026;
                    drop-shadow-offset-y: 2px;
                    VerticalLayout {
                        padding: 4px;
                        for ident[ii] in root.composer-identities: Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: idrow-ta.has-hover ? #f0f4fa : transparent;
                            idrow-ta := TouchArea {
                                clicked => {
                                    root.composer-identity-index = ii;
                                    root.identity-menu-open = false;
                                    root.identity-picked(ii);
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Rectangle {
                                    width: 10px;
                                    Rectangle {
                                        y: 13px;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: ident.tint;
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    // Только адрес: имя здесь ничего не решает,
                                    // а ошибаются именно адресом.
                                    text: ident.email;
                                    color: #0f1419;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if ii == root.composer-identity-index: Text {
                                    text: "✓";
                                    color: #10b981;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ========== Calendar view ==========

        // Calendar sidebar — same width as the mail sidebar, sharing the
        // splitter handle position.
        // (The calendar left panel was removed: navigation lives in the top
        // bar and the calendar list moved to Settings → Календарь.)

        // Calendar main pane (week grid)
        if root.view-mode == 1: VerticalLayout {
            // Top bar: burger + date nav (‹ Сегодня ›) + week title + New event.
            // The calendar list moved to Settings → Календарь; this bar owns
            // all navigation now (the left panel is gone).
            Rectangle {
                height: 52px;
                background: white;
                HorizontalLayout {
                    padding: 9px;
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 34px; height: 34px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: burger-c.has-hover ? #eef0f4 : transparent;
                        burger-c := TouchArea { clicked => { root.view-menu-open = !root.view-menu-open; } }
                        VerticalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 4px; alignment: center;
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                        }
                    }
                    // Prev
                    Rectangle {
                        width: 32px; height: 34px; y: (parent.height - self.height) / 2;
                        border-radius: 8px;
                        background: prv-ta.has-hover ? #eef0f4 : transparent;
                        prv-ta := TouchArea { clicked => { root.calendar-prev(); } }
                        Text { width: parent.width; height: parent.height; text: "‹"; color: #6b7480; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    // Today
                    Rectangle {
                        width: 84px; height: 34px; y: (parent.height - self.height) / 2;
                        border-radius: 8px;
                        background: tdy-ta.has-hover ? #eef0f4 : transparent;
                        tdy-ta := TouchArea { clicked => { root.calendar-today(); } }
                        Text { width: parent.width; height: parent.height; text: "Сегодня"; font-weight: 700; font-size: 13px; color: #0f1419; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    // Next
                    Rectangle {
                        width: 32px; height: 34px; y: (parent.height - self.height) / 2;
                        border-radius: 8px;
                        background: nxt-ta.has-hover ? #eef0f4 : transparent;
                        nxt-ta := TouchArea { clicked => { root.calendar-next(); } }
                        Text { width: parent.width; height: parent.height; text: "›"; color: #6b7480; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    // Week title
                    Text {
                        text: root.week-title;
                        font-weight: 700; font-size: 15px; color: #0f1419;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    // Loading pill. The layout is alignment:start, so a
                    // stretch spacer collapses to 0 and «+ Событие» painted
                    // right over the pill — reserve the pill's width
                    // explicitly while it's visible instead.
                    Rectangle {
                        width: root.calendar-loading ? 126px : 0px;
                        if root.calendar-loading: Rectangle {
                            x: 8px; y: (parent.height - self.height) / 2;
                            width: 110px; height: 26px; border-radius: 13px; background: #10b98122;
                            Text { width: parent.width; height: parent.height; text: "Загрузка…"; color: #10b981; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    // New event
                    Rectangle {
                        width: 118px; height: 34px; y: (parent.height - self.height) / 2;
                        border-radius: 8px;
                        background: ne-ta.has-hover ? #059669 : #10b981;
                        ne-ta := TouchArea { clicked => { root.new-event(); } }
                        Text { width: parent.width; height: parent.height; text: "+ Событие"; color: white; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            // Day header row — frozen vertically, tracks horizontal scroll via
            // grid-vp-x. Columns are absolutely placed so they line up with the
            // grid body; a white corner covers the gutter so scrolled-in
            // columns don't bleed under the time labels.
            Rectangle {
                height: 32px;
                background: white;
                clip: true;
                for h[d] in root.day-headers: Rectangle {
                    x: 48px + d * root.col-width + root.grid-vp-x;
                    width: root.col-width;
                    height: parent.height;
                    if d == root.today-col: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 3px;
                        width: min(parent.width - 8px, 96px);
                        height: parent.height - 6px;
                        border-radius: (parent.height - 6px) / 2;
                        background: #10b98118;
                    }
                    Text {
                        width: parent.width; height: parent.height;
                        text: h;
                        font-weight: 700; font-size: 12px;
                        color: d == root.today-col ? #10b981 : #6b7480;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle { x: 0; width: 48px; height: parent.height; background: white; }
            }
            // All-day band — chips above the hour grid, one per day touched.
            // Hidden entirely when there are no all-day events this week.
            if root.all-day-rows > 0: Rectangle {
                height: root.all-day-rows * 20px + 8px;
                background: white;
                clip: true;
                for ev[ei] in root.all-day-events: Rectangle {
                    x: 48px + ev.day * root.col-width + root.grid-vp-x + 2px;
                    y: ev.row * 20px + 4px;
                    width: root.col-width - 6px;
                    height: 18px;
                    background: @linear-gradient(180deg,
                        ev.color.brighter(0.10) 0%,
                        ev.color 45%,
                        ev.color.darker(0.06) 100%);
                    drop-shadow-blur: 2px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #0000002b;
                    border-radius: 4px;
                    ad-ta := TouchArea {
                        clicked => { root.event-clicked(ev.id); }
                        scroll-event(se) => {
                            if (se.modifiers.control && se.modifiers.alt) { root.calendar-zoom-days(se.delta-y); return accept; }
                            if (se.modifiers.control) { root.calendar-zoom-hours(se.delta-y); return accept; }
                            return reject;
                        }
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-text = (ev.title == "" ? "(без названия)" : ev.title) + " · весь день";
                                root.tip-x = self.absolute-position.x + self.mouse-x + 12px;
                                root.tip-y = self.absolute-position.y + self.mouse-y + 18px;
                                root.tip-armed = true;
                            } else {
                                root.tip-armed = false;
                                root.tip-visible = false;
                            }
                        }
                    }
                    Text {
                        x: 4px; y: 0;
                        width: parent.width - 8px;
                        height: parent.height;
                        text: ev.title;
                        color: white;
                        font-size: 10px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                // Frozen gutter label, drawn last so scrolled-in chips pass
                // behind it.
                Rectangle {
                    x: 0; width: 48px; height: parent.height; background: white;
                    Text {
                        width: 44px; height: parent.height;
                        text: "весь\nдень";
                        color: #8b95a1; font-size: 9px;
                        horizontal-alignment: right; vertical-alignment: center;
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    x: 0; width: parent.width; height: 1px;
                    background: #eef0f4;
                }
            }
            // ===== Scrollable grid body =====
            // 2-D Flickable holds the day columns; the time gutter (left) and
            // day-header row (above) are frozen and follow the body's scroll
            // via grid-vp-x / grid-vp-y mirrors.
            gb := Rectangle {
                vertical-stretch: 1;
                background: #f7f8fa;
                clip: true;
                property <length> content-w: 48px + root.day-count * root.col-width;
                property <length> content-h: (root.hour-end - root.hour-start) * root.hour-height;

                // Programmatic scroll bridge: reacts to grid-scroll-seq bumps
                // from Rust while the pane is alive (see the property block
                // for the pending half of the pattern).
                Rectangle {
                    visible: false;
                    width: 0;
                    height: 0;
                    x: root.grid-scroll-seq * 1px;
                    changed x => {
                        // Degenerate geometry (pane mid-instantiation) —
                        // keep pending; a later trigger applies it for real.
                        if (gridflick.height > 0) {
                            root.grid-scroll-pending = false;
                            gridflick.viewport-y = -max(0px, min(root.grid-scroll-y,
                                gridflick.viewport-height - gridflick.height));
                        }
                    }
                }
                gridflick := Flickable {
                    width: parent.width;
                    height: parent.height;
                    viewport-width: max(parent.width, gb.content-w);
                    viewport-height: max(parent.height, gb.content-h);
                    changed viewport-x => { root.grid-vp-x = self.viewport-x; }
                    changed viewport-y => { root.grid-vp-y = self.viewport-y; }
                    // The pane is conditional (view-mode == 1): a scroll asked
                    // for while it was being instantiated missed the seq
                    // bridge — apply it on the next real layout change instead
                    // (height settles, or the content grows once the zoom /
                    // event data lands).
                    changed height => {
                        if (root.grid-scroll-pending && self.height > 0) {
                            root.grid-scroll-pending = false;
                            self.viewport-y = -max(0px, min(root.grid-scroll-y,
                                self.viewport-height - self.height));
                        }
                    }
                    changed viewport-height => {
                        if (root.grid-scroll-pending && self.height > 0) {
                            root.grid-scroll-pending = false;
                            self.viewport-y = -max(0px, min(root.grid-scroll-y,
                                self.viewport-height - self.height));
                        }
                    }

                    // Non-work shading (above work-start / below work-end).
                    if root.work-start > root.hour-start: Rectangle {
                        x: 48px; y: 0;
                        width: root.day-count * root.col-width;
                        height: (root.work-start - root.hour-start) * root.hour-height;
                        background: #11182708;
                    }
                    if root.work-end < root.hour-end: Rectangle {
                        x: 48px;
                        y: (root.work-end - root.hour-start) * root.hour-height;
                        width: root.day-count * root.col-width;
                        height: (root.hour-end - root.work-end) * root.hour-height;
                        background: #11182708;
                    }
                    // Today's column tint.
                    if root.today-col >= 0: Rectangle {
                        x: 48px + root.today-col * root.col-width;
                        y: 0;
                        width: root.col-width;
                        height: gridflick.viewport-height;
                        background: #10b9810a;
                    }
                    // Quarter-hour rules: :00 normal, :30 thin solid, :15/:45
                    // thin dashed.
                    for q in (root.hour-end - root.hour-start) * 4: Rectangle {
                        x: 48px;
                        y: q * root.hour-height / 4;
                        width: root.day-count * root.col-width;
                        height: 1px;
                        background: Math.mod(q, 4) == 0
                            ? #c4ccd6
                            : (Math.mod(q, 4) == 2 ? #dde3ea : transparent);
                        if Math.mod(q, 4) != 0 && Math.mod(q, 4) != 2: DashLine {
                            width: parent.width;
                            count: root.dash-count;
                        }
                    }
                    // Day-column dividers.
                    for h[d] in root.day-headers: Rectangle {
                        x: 48px + d * root.col-width;
                        y: 0;
                        width: 1px;
                        height: gridflick.viewport-height;
                        background: #d8dee7;
                    }
                    // Empty-grid double-click → new event at that slot. Behind
                    // the chips, so it only fires on free space (incl. the 4px
                    // strip kept to the right of every chip). Ctrl-/Ctrl-Alt-
                    // wheel zooms; plain wheel falls through to the Flickable.
                    grid-bg := TouchArea {
                        // Explicit content-sized geometry: a direct Flickable
                        // child's `100%` resolves to 0 (the content has no
                        // bounded parent size), which is why this never got any
                        // events while the px-sized blocks did.
                        x: 0;
                        y: 0;
                        width: 48px + root.day-count * root.col-width;
                        height: gridflick.viewport-height;
                        // Low-level press → Rust detects the double (two presses,
                        // same spot, < 450 ms); `clicked`/`double-clicked` are
                        // unreliable for a full-area child of a Flickable.
                        pointer-event(pe) => {
                            if (pe.kind == PointerEventKind.down && pe.button == PointerEventButton.left) {
                                root.grid-create-at(self.mouse-x, self.mouse-y, gridflick.viewport-width);
                            }
                        }
                        scroll-event(se) => {
                            if (se.modifiers.control && se.modifiers.alt) { root.calendar-zoom-days(se.delta-y); return accept; }
                            if (se.modifiers.control) { root.calendar-zoom-hours(se.delta-y); return accept; }
                            return reject;
                        }
                    }
                    // Event blocks.
                    for ev[ei] in root.events: Rectangle {
                        x: 48px + (ev.day + ev.xf) * root.col-width + 2px;
                        y: ev.top;
                        width: root.col-width * ev.wf - 6px;
                        height: ev.h;
                        background: @linear-gradient(180deg,
                            ev.color.brighter(0.10) 0%,
                            ev.color 45%,
                            ev.color.darker(0.06) 100%);
                        opacity: (root.cal-drag-id == ev.id && root.cal-dragging)
                            ? 0.35
                            : (ev.tentative ? 0.55 : 1.0);
                        border-width: ev.tentative ? 1px : 0px;
                        border-color: white.transparentize(0.45);
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: #00000033;
                        border-radius: 4px;
                        ev-ta := TouchArea {
                            mouse-cursor: ev.writable ? MouseCursor.grab : MouseCursor.default;
                            // Click opens the detail card — but not if this
                            // press turned into a drag (cal-dragging stays set
                            // until the next press).
                            clicked => {
                                if (!root.cal-dragging) { root.event-clicked(ev.id); }
                            }
                            pointer-event(pe) => {
                                if (!ev.writable || pe.button != PointerEventButton.left) { return; }
                                if (pe.kind == PointerEventKind.down) {
                                    root.cal-drag-id = ev.id;
                                    root.cal-drag-mode = 0; // move
                                    root.cal-dragging = false;
                                    root.cal-drag-x0 = 48px + (ev.day + ev.xf) * root.col-width + 2px;
                                    root.cal-drag-y0 = ev.top;
                                    root.cal-drag-x = root.cal-drag-x0;
                                    root.cal-drag-y = root.cal-drag-y0;
                                    root.cal-drag-w = root.col-width * ev.wf - 6px;
                                    root.cal-drag-h = ev.h;
                                    root.cal-drag-h0 = ev.h;
                                    root.cal-drag-title = ev.title;
                                    root.cal-drag-color = ev.color;
                                } else if (pe.kind == PointerEventKind.up) {
                                    if (root.cal-drag-id == ev.id && root.cal-dragging) {
                                        root.grid-event-moved(ev.id, root.cal-drag-x0, root.cal-drag-y0, root.cal-drag-x, root.cal-drag-y);
                                    }
                                    // Hide the ghost; keep cal-dragging until the
                                    // next press so `clicked` can skip a drag.
                                    root.cal-drag-id = -1;
                                }
                            }
                            moved => {
                                if (root.cal-drag-id == ev.id) {
                                    if (Math.abs(self.mouse-x - self.pressed-x) > 4px
                                        || Math.abs(self.mouse-y - self.pressed-y) > 4px) {
                                        root.cal-dragging = true;
                                    }
                                    root.cal-drag-x = root.cal-drag-x0 + (self.mouse-x - self.pressed-x);
                                    root.cal-drag-y = root.cal-drag-y0 + (self.mouse-y - self.pressed-y);
                                }
                            }
                            scroll-event(se) => {
                                if (se.modifiers.control && se.modifiers.alt) { root.calendar-zoom-days(se.delta-y); return accept; }
                                if (se.modifiers.control) { root.calendar-zoom-hours(se.delta-y); return accept; }
                                return reject;
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.tip-text = ev.time + " — " + (ev.title == "" ? "(без названия)" : ev.title);
                                    root.tip-x = self.absolute-position.x + self.mouse-x + 12px;
                                    root.tip-y = self.absolute-position.y + self.mouse-y + 18px;
                                    root.tip-armed = true;
                                } else {
                                    root.tip-armed = false;
                                    root.tip-visible = false;
                                }
                            }
                        }
                        Text {
                            x: 4px; y: 2px;
                            width: parent.width - 8px - (ev.count >= 2 ? 18px : 0px);
                            height: parent.height - 4px;
                            text: ev.title;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                            overflow: elide;
                            wrap: word-wrap;
                        }
                        if ev.count >= 2: Rectangle {
                            x: parent.width - self.width - 3px;
                            y: 2px;
                            width: max(16px, cnt-t.preferred-width + 10px);
                            height: 14px;
                            border-radius: 7px;
                            background: #00000038;
                            cnt-t := Text {
                                width: parent.width;
                                height: parent.height;
                                text: ev.count;
                                color: white;
                                font-size: 9px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        // Resize grips (writable only). Top edge → start, bottom
                        // edge → end; the opposite edge stays fixed (the ghost's
                        // y + h arithmetic keeps it pinned).
                        if ev.writable: TouchArea {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 7px;
                            mouse-cursor: MouseCursor.ns-resize;
                            pointer-event(pe) => {
                                if (pe.button != PointerEventButton.left) { return; }
                                if (pe.kind == PointerEventKind.down) {
                                    root.cal-drag-id = ev.id;
                                    root.cal-drag-mode = 1;
                                    root.cal-dragging = false;
                                    root.cal-drag-x0 = 48px + (ev.day + ev.xf) * root.col-width + 2px;
                                    root.cal-drag-y0 = ev.top;
                                    root.cal-drag-x = root.cal-drag-x0;
                                    root.cal-drag-y = root.cal-drag-y0;
                                    root.cal-drag-w = root.col-width * ev.wf - 6px;
                                    root.cal-drag-h = ev.h;
                                    root.cal-drag-h0 = ev.h;
                                    root.cal-drag-title = ev.title;
                                    root.cal-drag-color = ev.color;
                                } else if (pe.kind == PointerEventKind.up) {
                                    if (root.cal-drag-id == ev.id && root.cal-dragging) {
                                        root.grid-event-resized(ev.id, root.cal-drag-x0, root.cal-drag-y0, root.cal-drag-y, root.cal-drag-y + root.cal-drag-h);
                                    }
                                    root.cal-drag-id = -1;
                                }
                            }
                            moved => {
                                if (root.cal-drag-id == ev.id) {
                                    if (Math.abs(self.mouse-y - self.pressed-y) > 3px) { root.cal-dragging = true; }
                                    root.cal-drag-y = Math.min(
                                        root.cal-drag-y0 + root.cal-drag-h0 - 18px,
                                        root.cal-drag-y0 + (self.mouse-y - self.pressed-y));
                                    root.cal-drag-h = Math.max(18px, root.cal-drag-y0 + root.cal-drag-h0 - root.cal-drag-y);
                                }
                            }
                        }
                        if ev.writable: TouchArea {
                            x: 0;
                            y: parent.height - 7px;
                            width: parent.width;
                            height: 7px;
                            mouse-cursor: MouseCursor.ns-resize;
                            pointer-event(pe) => {
                                if (pe.button != PointerEventButton.left) { return; }
                                if (pe.kind == PointerEventKind.down) {
                                    root.cal-drag-id = ev.id;
                                    root.cal-drag-mode = 2;
                                    root.cal-dragging = false;
                                    root.cal-drag-x0 = 48px + (ev.day + ev.xf) * root.col-width + 2px;
                                    root.cal-drag-y0 = ev.top;
                                    root.cal-drag-x = root.cal-drag-x0;
                                    root.cal-drag-y = root.cal-drag-y0;
                                    root.cal-drag-w = root.col-width * ev.wf - 6px;
                                    root.cal-drag-h = ev.h;
                                    root.cal-drag-h0 = ev.h;
                                    root.cal-drag-title = ev.title;
                                    root.cal-drag-color = ev.color;
                                } else if (pe.kind == PointerEventKind.up) {
                                    if (root.cal-drag-id == ev.id && root.cal-dragging) {
                                        root.grid-event-resized(ev.id, root.cal-drag-x0, root.cal-drag-y0, root.cal-drag-y, root.cal-drag-y + root.cal-drag-h);
                                    }
                                    root.cal-drag-id = -1;
                                }
                            }
                            moved => {
                                if (root.cal-drag-id == ev.id) {
                                    if (Math.abs(self.mouse-y - self.pressed-y) > 3px) { root.cal-dragging = true; }
                                    root.cal-drag-h = Math.max(18px, root.cal-drag-h0 + (self.mouse-y - self.pressed-y));
                                }
                            }
                        }
                    }
                    // Drag ghost — a translucent copy that follows the cursor
                    // while a block is being moved.
                    if root.cal-drag-id >= 0 && root.cal-dragging: Rectangle {
                        x: root.cal-drag-x;
                        y: root.cal-drag-y;
                        width: root.cal-drag-w;
                        height: root.cal-drag-h;
                        background: root.cal-drag-color;
                        opacity: 0.85;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: white;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000066;
                        Text {
                            x: 4px; y: 2px;
                            width: parent.width - 8px;
                            height: parent.height - 4px;
                            text: root.cal-drag-title;
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                            overflow: elide;
                            wrap: word-wrap;
                        }
                    }
                    // Now-line across today's column.
                    if root.today-col >= 0
                        && root.now-hour >= root.hour-start
                        && root.now-hour <= root.hour-end: Rectangle {
                        x: 48px + root.today-col * root.col-width;
                        y: (root.now-hour - root.hour-start) * root.hour-height - 1px;
                        width: root.col-width;
                        height: 2px;
                        background: #eb5757;
                        Rectangle {
                            x: -3px; y: -2px;
                            width: 6px; height: 6px;
                            border-radius: 3px;
                            background: #eb5757;
                        }
                    }
                }

                // Frozen time gutter — labels follow vertical scroll only.
                Rectangle {
                    x: 0; y: 0; width: 48px; height: parent.height;
                    background: #f7f8fa;
                    clip: true;
                    for i in (root.hour-end - root.hour-start + 1): Text {
                        x: 0;
                        y: i * root.hour-height - 8px + root.grid-vp-y;
                        width: 44px; height: 16px;
                        text: (root.hour-start + i) + ":00";
                        color: #8b95a1;
                        font-size: 11px;
                        horizontal-alignment: right;
                    }
                }
                // Scroll thumbs (visual; pan via wheel / drag).
                if gb.content-h > gb.height: Rectangle {
                    width: 4px;
                    x: parent.width - 6px;
                    y: -root.grid-vp-y / gb.content-h * gb.height;
                    height: max(24px, gb.height / gb.content-h * gb.height);
                    background: #00000026;
                    border-radius: 2px;
                }
                if gb.content-w > gb.width: Rectangle {
                    height: 4px;
                    y: parent.height - 6px;
                    x: 48px + (-root.grid-vp-x / gb.content-w * gb.width);
                    width: max(24px, gb.width / gb.content-w * gb.width);
                    background: #00000026;
                    border-radius: 2px;
                }
                // Report the body size to Rust so the layout math can react.
                init => { root.grid-area-resized(self.width, self.height); }
                changed width => { root.grid-area-resized(self.width, self.height); }
                changed height => { root.grid-area-resized(self.width, self.height); }
            }
        }
        // ---------- Address book (view-mode 2) ----------
        if root.view-mode == 2: Rectangle {
            horizontal-stretch: 1;
            background: #f7f8fa;
            VerticalLayout {
                // Header: burger + title.
                Rectangle {
                    height: 56px;
                    Rectangle {
                        x: 10px; y: 10px; width: 36px; height: 36px;
                        border-radius: 10px;
                        background: burger-ab.has-hover ? #e1e6ee : transparent;
                        burger-ab := TouchArea { clicked => { root.view-menu-open = !root.view-menu-open; } }
                        VerticalLayout {
                            padding-left: 9px; padding-right: 9px; spacing: 4px; alignment: center;
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                            Rectangle { height: 2px; border-radius: 1px; background: #6b7480; }
                        }
                    }
                    Text {
                        x: 60px; width: parent.width - 120px; height: 56px;
                        text: "Контакты";
                        font-size: 18px; font-weight: 700; color: #0f1419;
                        vertical-alignment: center;
                    }
                    // "+" — new contact.
                    Rectangle {
                        x: parent.width - 46px; y: 10px; width: 36px; height: 36px;
                        border-radius: 10px;
                        background: ab-add.has-hover ? #d7e6ff : #eaf2fe;
                        ab-add := TouchArea { clicked => { root.contact-add(); } }
                        // Drawn plus (glyph font unreliable on Windows).
                        Rectangle { width: 14px; height: 2px; border-radius: 1px; background: #10b981; }
                        Rectangle { width: 2px; height: 14px; border-radius: 1px; background: #10b981; }
                    }
                }
                // Search box.
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                    cb-search := KLineEdit {
                        placeholder-text: "Поиск контактов";
                        text <=> root.contacts-query;
                        edited => { root.contacts-search(root.contacts-query); }
                    }
                }
                // Rows.
                ListView {
                    vertical-stretch: 1;
                    for c[idx] in root.address-book: Rectangle {
                        height: 60px;
                        background: ab-row.has-hover ? #eef2f7 : transparent;
                        ab-row := TouchArea { clicked => { root.contact-edit(idx); } }
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 40px; height: 40px; border-radius: 20px;
                                y: (parent.height - self.height) / 2;
                                background: c.color;
                                Text {
                                    text: c.initials;
                                    color: white; font-size: 15px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 2px;
                                Text {
                                    text: c.name;
                                    font-size: 14px; font-weight: 600; color: #0f1419;
                                    overflow: elide;
                                }
                                Text {
                                    text: c.detail;
                                    font-size: 12px; color: #6b7480;
                                    overflow: elide;
                                }
                            }
                        }
                        Rectangle {
                            x: 66px; y: parent.height - 1px;
                            width: parent.width - 66px; height: 1px;
                            background: #edf0f3;
                        }
                    }
                }
            }
        }
    }

    // ---------- View switcher (burger) overlay ----------
    // Backdrop catches outside clicks; the little menu sits under the
    // top-left burger and switches between Почта / Календарь.
    if root.view-menu-open: TouchArea {
        clicked => { root.view-menu-open = false; }
        Rectangle {
            x: 10px;
            y: 54px;
            width: 220px;
            height: 164px;
            background: white;
            border-radius: 10px;
            border-width: 1px;
            border-color: #e6ecf2;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000022;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: root.view-mode == 0 ? #eaf2fe : (vm-mail.has-hover ? #f0f2f5 : transparent);
                    vm-mail := TouchArea {
                        clicked => { root.view-mode = 0; root.view-changed(0); root.view-menu-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Text { text: "✉"; font-size: 16px; color: #10b981; vertical-alignment: center; }
                        Text { text: "Почта"; font-size: 14px; font-weight: 600; color: #0f1419; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: root.view-mode == 1 ? #eaf2fe : (vm-cal.has-hover ? #f0f2f5 : transparent);
                    vm-cal := TouchArea {
                        clicked => { root.view-mode = 1; root.view-changed(1); root.view-menu-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Text { text: "📅"; font-size: 16px; vertical-alignment: center; }
                        Text { text: "Календарь"; font-size: 14px; font-weight: 600; color: #0f1419; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: root.view-mode == 2 ? #eaf2fe : (vm-con.has-hover ? #f0f2f5 : transparent);
                    vm-con := TouchArea {
                        clicked => { root.view-mode = 2; root.view-changed(2); root.view-menu-open = false; }
                    }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Text { text: "👤"; font-size: 16px; vertical-alignment: center; }
                        Text { text: "Контакты"; font-size: 14px; font-weight: 600; color: #0f1419; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: vm-set.has-hover ? #f0f2f5 : transparent;
                    vm-set := TouchArea {
                        clicked => { root.view-menu-open = false; root.open-settings(); }
                    }
                    HorizontalLayout {
                        padding-left: 12px; spacing: 10px; alignment: start;
                        Text { text: "⚙"; font-size: 16px; color: #6b7480; vertical-alignment: center; }
                        Text {
                            text: "Настройки";
                            font-size: 14px; font-weight: 600; color: #0f1419;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ---------- Empty state (no connections) ----------
    if !root.has-connections && !root.engine-reloading: Rectangle {
        background: #f7f8fa;
        VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: "Нет подключений";
                font-size: 20px; font-weight: 700; color: #0f1419;
                horizontal-alignment: center;
            }
            Text {
                text: "Добавьте почтовый аккаунт, чтобы начать.";
                font-size: 14px; color: #6b7480;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                efc-btn := TouchArea {
                    width: 220px; height: 44px;
                    clicked => { root.add-first-connection(); }
                    Rectangle {
                        background: efc-btn.has-hover ? #4f7df5 : #3a6df0;
                        border-radius: 8px;
                        Text {
                            text: "Добавить подключение";
                            color: white; font-size: 15px; font-weight: 700;
                        }
                    }
                }
            }
        }
    }

    // ---------- Engine-reloading banner ----------
    if root.engine-reloading: Rectangle {
        x: (root.width - self.width) / 2;
        y: 8px;
        width: 260px;
        height: 34px;
        background: #23262b;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;
        HorizontalLayout {
            padding-left: 14px; padding-right: 14px; spacing: 10px; alignment: center;
            // Small pulsing dot so it clearly isn't frozen.
            dot := Rectangle {
                width: 8px; height: 8px; border-radius: 4px; background: #3a6df0;
                opacity: 0.4;
                animate opacity { duration: 700ms; iteration-count: -1; direction: alternate; }
            }
            Text {
                text: "Обновление подключений…";
                color: #e8eaed; font-size: 13px; vertical-alignment: center;
            }
        }
    }

    // ---------- Contact editor overlay ----------
    if root.contact-editor-open: TouchArea {
        clicked => { root.contact-editor-cancel(); }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            // Height follows the content so the buttons are never clipped and
            // the account picker (create) fits when shown.
            height: ce-col.preferred-height;
            background: white;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e6ecf2;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000022;
            TouchArea { } // swallow clicks on the card
            ce-col := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: root.ce-is-edit ? "Изменить контакт" : "Новый контакт";
                    font-size: 17px; font-weight: 700; color: #0f1419;
                }
                if !root.ce-is-edit && root.ce-accounts.length > 1: Text {
                    text: "Аккаунт"; font-size: 12px; color: #6b7480;
                }
                if !root.ce-is-edit && root.ce-accounts.length > 1: ComboBox {
                    model: root.ce-accounts;
                    current-index <=> root.ce-account-idx;
                }
                Text { text: "Имя"; font-size: 12px; color: #6b7480; }
                KLineEdit { text <=> root.ce-name; font-size: 14px; }
                Text { text: "Email"; font-size: 12px; color: #6b7480; }
                KLineEdit { text <=> root.ce-email; font-size: 14px; }
                Text { text: "Телефон"; font-size: 12px; color: #6b7480; }
                KLineEdit { text <=> root.ce-phone; font-size: 14px; }
                Text { text: "Организация"; font-size: 12px; color: #6b7480; }
                KLineEdit { text <=> root.ce-org; font-size: 14px; }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 8px;
                    if root.ce-is-edit: ce-del := TouchArea {
                        height: 38px; width: 90px;
                        clicked => { root.contact-delete(); }
                        Rectangle {
                            background: ce-del.has-hover ? #ffe1e1 : #fff0f0;
                            border-radius: 8px;
                            Text { text: "Удалить"; color: #d64545; font-size: 14px; font-weight: 600; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ce-cancel := TouchArea {
                        height: 38px; width: 90px;
                        clicked => { root.contact-editor-cancel(); }
                        Rectangle {
                            background: ce-cancel.has-hover ? #eef0f3 : #f5f6f8;
                            border-radius: 8px;
                            Text { text: "Отмена"; color: #0f1419; font-size: 14px; }
                        }
                    }
                    ce-save := TouchArea {
                        height: 38px; width: 110px;
                        clicked => { root.contact-save(); }
                        Rectangle {
                            background: ce-save.has-hover ? #4f7df5 : #3a6df0;
                            border-radius: 8px;
                            Text { text: "Сохранить"; color: white; font-size: 14px; font-weight: 700; }
                        }
                    }
                }
            }
        }
    }

    // ---------- Calendar colour-picker overlay ----------
    // Two rows of palette swatches; click assigns the colour to the
    // calendar whose swatch opened the popup.
    if root.color-picker-cal >= 0: TouchArea {
        clicked => { root.color-picker-cal = -1; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 6 * 32px + 5 * 8px + 28px;
            height: 2 * 32px + 8px + 28px;
            background: white;
            border-radius: 12px;
            border-width: 1px;
            border-color: #e6ecf2;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000022;
            // Swallow clicks on the card body so only the backdrop closes.
            TouchArea { }
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    for i in 6: Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.cal-palette[i];
                        TouchArea {
                            clicked => {
                                root.calendar-set-color(root.color-picker-cal, i);
                                root.color-picker-cal = -1;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    for i in 6: Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: root.cal-palette[i + 6];
                        TouchArea {
                            clicked => {
                                root.calendar-set-color(root.color-picker-cal, i + 6);
                                root.color-picker-cal = -1;
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- Event-detail modal overlay ----------
    if root.detail-visible: TouchArea {
        // Backdrop: click outside the card closes the popup.
        clicked => { root.detail-close(); }
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { root.detail-close(); kb.focus(); return accept; }
                reject
            }
        Rectangle {
            background: #00000066;
            card := Rectangle {
                width: min(520px, root.width - 80px);
                // Content-sized: a short event gets a short card; tall
                // content is capped to the window (inner parts scroll).
                height: min(root.height - 80px, dd-body.preferred-height + 40px);
                background: white;
                border-radius: 14px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000044;
                // Swallow clicks on the card so they don't hit the backdrop.
                TouchArea {}
                dd-body := VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: root.detail-title;
                            font-size: 18px;
                            font-weight: 700;
                            color: #0f1419;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            width: 90px; height: 28px; border-radius: 8px;
                            background: e-ta.has-hover ? #e1e6ee : #f0f2f5;
                            Text { text: "Изменить"; color: #10b981; font-size: 13px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            e-ta := TouchArea { clicked => { root.detail-edit(); } }
                        }
                        Rectangle { width: 6px; }
                        Rectangle {
                            width: 84px; height: 28px; border-radius: 8px;
                            background: del-ta.has-hover ? #f7d7d7 : #f0f2f5;
                            Text { text: "Удалить"; color: #eb5757; font-size: 13px; font-weight: 600;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            del-ta := TouchArea { clicked => { root.detail-delete(); } }
                        }
                        Rectangle { width: 6px; }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 14px;
                            background: x-ta.has-hover ? #e1e6ee : transparent;
                            // Drawn cross — the ✕ glyph is missing from the
                            // default Windows font (same story as the burger).
                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                stroke: #6b7480;
                                stroke-width: 2px;
                                MoveTo { x: 1; y: 1; }
                                LineTo { x: 9; y: 9; }
                                MoveTo { x: 9; y: 1; }
                                LineTo { x: 1; y: 9; }
                            }
                            x-ta := TouchArea { clicked => { root.detail-close(); } }
                        }
                    }
                    // Date/time: plain dark text (a blue line here read as
                    // a hyperlink), humanized by the Rust side.
                    Text { text: root.detail-when; font-size: 14px; font-weight: 600; color: #0f1419; }
                    if root.detail-location != "": Text {
                        text: "📍 " + root.detail-location; font-size: 13px; color: #4a5560; wrap: word-wrap;
                    }
                    if root.detail-organizer != "": Text {
                        text: "Организатор: " + root.detail-organizer; font-size: 13px; color: #4a5560; wrap: word-wrap;
                    }
                    if root.detail-meta != "": Text {
                        text: root.detail-meta; font-size: 12px; font-weight: 600; color: #b3541e;
                    }
                    // Non-default event properties: conference link, event
                    // URL, categories, privacy… Links open in the browser.
                    for ex in root.detail-extras: HorizontalLayout {
                        spacing: 8px;
                        height: 22px;
                        Text {
                            width: 110px;
                            text: ex.label;
                            font-size: 12px;
                            color: #5b6672;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: dex-ta.has-hover && ex.is-link ? #e8f0fe : transparent;
                            dex-ta := TouchArea {
                                enabled: ex.is-link;
                                mouse-cursor: ex.is-link ? MouseCursor.pointer : MouseCursor.default;
                                clicked => { root.detail-open-link(ex.value); }
                            }
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                height: parent.height;
                                text: ex.value;
                                font-size: 13px;
                                color: ex.is-link ? #10b981 : #0f1419;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    // Attendees — a proper two-column table (name | status),
                    // scrollable when long.
                    if root.detail-attendee-rows.length > 0: Rectangle {
                        height: min(att-col.preferred-height + 12px, 168px);
                        border-radius: 8px;
                        background: #f7f8fa;
                        clip: true;
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-height: att-col.preferred-height + 12px;
                            att-col := VerticalLayout {
                                x: 0; y: 6px;
                                width: parent.width;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 3px;
                                for a in root.detail-attendee-rows: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: a.name;
                                        font-size: 13px;
                                        color: #2b3640;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: a.status;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: a.color;
                                    }
                                }
                            }
                        }
                    }
                    // Links recognised in the event data (location +
                    // description, plain text included) — one clickable
                    // row each, opens the system browser.
                    for lnk in root.detail-links: Rectangle {
                        height: 24px;
                        border-radius: 6px;
                        background: lnk-ta.has-hover ? #e8f0fe : transparent;
                        lnk-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.detail-open-link(lnk); }
                        }
                        Text {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text: "🔗 " + lnk;
                            font-size: 13px;
                            color: #10b981;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    if root.detail-description != "": Rectangle {
                        height: min(desc.preferred-height + 4px, 220px);
                        clip: true;
                        Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-height: desc.preferred-height;
                            desc := Text {
                                width: parent.width;
                                text: root.detail-description;
                                font-size: 13px;
                                color: #2b3640;
                                wrap: word-wrap;
                            }
                        }
                    }
                    // RSVP — at the bottom; my current answer is the solid
                    // button, the alternatives are pale with coloured text.
                    if root.detail-attendee-rows.length > 0: Rectangle {
                        height: 36px;
                        HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            border-radius: 8px;
                            border-width: root.detail-my-partstat == "ACCEPTED" ? 2px : 0px;
                            border-color: #1f8b4c;
                            background: root.detail-my-partstat == "ACCEPTED"
                                ? (ac-ta.has-hover ? #1f8b4c : #27ae60)
                                : (ac-ta.has-hover ? #27ae6033 : #27ae6018);
                            Text {
                                text: "Принять";
                                color: root.detail-my-partstat == "ACCEPTED" ? white : #1f8b4c;
                                font-size: 13px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            ac-ta := TouchArea {
                                clicked => { root.rsvp(root.detail-event-id, "ACCEPTED"); root.detail-close(); }
                            }
                        }
                        Rectangle {
                            border-radius: 8px;
                            border-width: root.detail-my-partstat == "TENTATIVE" ? 2px : 0px;
                            border-color: #d98324;
                            background: root.detail-my-partstat == "TENTATIVE"
                                ? (tn-ta.has-hover ? #d98324 : #f2994a)
                                : (tn-ta.has-hover ? #f2994a33 : #f2994a18);
                            Text {
                                text: "Возможно";
                                color: root.detail-my-partstat == "TENTATIVE" ? white : #c47a1d;
                                font-size: 13px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            tn-ta := TouchArea {
                                clicked => { root.rsvp(root.detail-event-id, "TENTATIVE"); root.detail-close(); }
                            }
                        }
                        Rectangle {
                            border-radius: 8px;
                            border-width: root.detail-my-partstat == "DECLINED" ? 2px : 0px;
                            border-color: #d63d3d;
                            background: root.detail-my-partstat == "DECLINED"
                                ? (dc-ta.has-hover ? #d63d3d : #eb5757)
                                : (dc-ta.has-hover ? #eb575733 : #eb575718);
                            Text {
                                text: "Отклонить";
                                color: root.detail-my-partstat == "DECLINED" ? white : #d63d3d;
                                font-size: 13px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            dc-ta := TouchArea {
                                clicked => { root.rsvp(root.detail-event-id, "DECLINED"); root.detail-close(); }
                            }
                        }
                        }
                    }
                }
            }
        }
        }
    }

    // ---------- Event create/edit modal ----------
    if root.edit-visible: TouchArea {
        clicked => { root.edit-cancel(); }
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) { root.edit-cancel(); kb.focus(); return accept; }
                reject
            }
        Rectangle {
            background: #00000066;
            Rectangle {
                width: min(520px, root.width - 80px);
                height: min(620px, root.height - 80px);
                background: white;
                border-radius: 14px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000044;
                TouchArea {}
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Text {
                        text: root.edit-is-create ? "Новое событие" : "Изменить событие";
                        font-size: 18px; font-weight: 700; color: #0f1419;
                    }
                    // Read-only meeting details. Present only when the event
                    // carries them (organizer/attendees come from iTIP/CalDAV
                    // and aren't editable here).
                    if root.edit-meta != "": Text {
                        text: root.edit-meta;
                        font-size: 12px;
                        font-weight: 600;
                        color: #b3541e;
                    }
                    // Extra event properties: conference link, event URL,
                    // categories, privacy… Everything non-default the event
                    // carries beyond the editable fields below.
                    for ex in root.edit-extras: HorizontalLayout {
                        spacing: 8px;
                        height: 20px;
                        Text {
                            width: 110px;
                            text: ex.label;
                            font-size: 12px;
                            color: #5b6672;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            ex-ta := TouchArea {
                                enabled: ex.is-link;
                                mouse-cursor: ex.is-link ? MouseCursor.pointer : MouseCursor.default;
                                clicked => { root.edit-open-url(ex.value); }
                            }
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: ex.value;
                                font-size: 13px;
                                color: ex.is-link ? #10b981 : #0f1419;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    if root.edit-organizer != "": VerticalLayout {
                        spacing: 3px;
                        Text { text: "Организатор"; font-size: 12px; color: #5b6672; }
                        Text {
                            text: root.edit-organizer;
                            font-size: 13px;
                            color: #0f1419;
                            overflow: elide;
                        }
                    }
                    if root.edit-attendees.length > 0: VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Участники (" + root.edit-attendees.length + ")";
                            font-size: 12px;
                            color: #5b6672;
                        }
                        // Cap at four rows; longer lists scroll in place.
                        Flickable {
                            height: min(root.edit-attendees.length * 22px, 88px);
                            viewport-height: root.edit-attendees.length * 22px;
                            VerticalLayout {
                                for at in root.edit-attendees: HorizontalLayout {
                                    spacing: 6px;
                                    height: 22px;
                                    Rectangle {
                                        width: 8px;
                                        Rectangle {
                                            y: 7px;
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: at.dot;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: at.label;
                                        font-size: 13px;
                                        color: #0f1419;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    CalField {
                        label: "Тема";
                        placeholder: "Название события";
                        value <=> root.edit-title;
                    }
                    // Calendar picker — selectable chips (std ComboBox renders
                    // poorly here).
                    VerticalLayout {
                        spacing: 3px;
                        Text { text: "Календарь"; font-size: 12px; color: #5b6672; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for name[i] in root.edit-calendars: Rectangle {
                                height: 30px;
                                border-radius: 7px;
                                background: root.edit-calendar-idx == i ? #10b981 : #eef2f7;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: name;
                                        color: root.edit-calendar-idx == i ? white : #2b3640;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.edit-calendar-idx = i; } }
                            }
                        }
                    }
                    // All-day toggle.
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        ad-box := Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: root.edit-all-day ? #10b981 : #c8d4e4;
                            background: root.edit-all-day ? #10b981 : white;
                            Text {
                                text: "✓";
                                color: white;
                                font-size: 13px;
                                visible: root.edit-all-day;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.edit-all-day = !root.edit-all-day; } }
                        }
                        Text {
                            text: "Весь день";
                            color: #2b3640;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    DateTimeField {
                        label: "Начало";
                        all-day: root.edit-all-day;
                        year <=> root.edit-s-year;
                        month <=> root.edit-s-month;
                        day <=> root.edit-s-day;
                        hour <=> root.edit-s-hour;
                        minute <=> root.edit-s-min;
                    }
                    DateTimeField {
                        label: "Конец";
                        all-day: root.edit-all-day;
                        year <=> root.edit-e-year;
                        month <=> root.edit-e-month;
                        day <=> root.edit-e-day;
                        hour <=> root.edit-e-hour;
                        minute <=> root.edit-e-min;
                    }
                    CalField {
                        label: "Место";
                        placeholder: "—";
                        value <=> root.edit-location;
                    }
                    CalField {
                        label: "Описание";
                        placeholder: "—";
                        value <=> root.edit-description;
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Отмена"; clicked => { root.edit-cancel(); } }
                        Button { text: "Сохранить"; primary: true; clicked => { root.edit-save(); } }
                    }
                }
            }
        }
        }
    }

    // ---------- Source viewer («Показать → …», read-only) ----------
    if root.source-view-visible: TouchArea {
        clicked => { root.source-view-visible = false; kb.focus(); }
        Rectangle {
            // Keyboard for this modal is handled by the main `kb` FocusScope
            // (its source-view-visible branch) so there's a single focus owner.
        Rectangle {
            background: #00000066;
            Rectangle {
                width: min(860px, root.width - 80px);
                height: min(640px, root.height - 80px);
                background: white;
                border-radius: 14px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000044;
                TouchArea {}
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.source-view-title;
                            font-size: 16px; font-weight: 700; color: #0f1419;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            width: sv-copy-txt.preferred-width + 20px;
                            height: 28px; border-radius: 8px;
                            background: sv-copy.has-hover ? #d7deea : #e9edf3;
                            sv-copy-txt := Text {
                                text: "Копировать всё";
                                font-size: 12px; font-weight: 600; color: #2b3640;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            sv-copy := TouchArea {
                                clicked => { root.source-view-copy(); }
                            }
                        }
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 8px;
                            background: sv-x.has-hover ? #e1e6ee : transparent;
                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                viewbox-width: 10;
                                viewbox-height: 10;
                                stroke: #6b7480;
                                stroke-width: 2px;
                                MoveTo { x: 1; y: 1; }
                                LineTo { x: 9; y: 9; }
                                MoveTo { x: 9; y: 1; }
                                LineTo { x: 1; y: 9; }
                            }
                            sv-x := TouchArea {
                                clicked => { root.source-view-visible = false; kb.focus(); }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: #f7f8fa;
                        border-radius: 8px;
                        clip: true;

                        // Raw text (source / body source): rendered to a bitmap
                        // by WebKit (like a message bubble), selected via the
                        // fast Rust text-run layer — Slint's TextInput lays out
                        // the whole string on every selection event and crawls
                        // even on small text. «Копировать всё» copies the full
                        // (untruncated) source.
                        if !root.source-view-is-headers: ScrollView {
                            width: parent.width;
                            height: parent.height;
                            // A bare Rectangle reports preferred-height 0, so the
                            // ScrollView wouldn't know there's anything to scroll
                            // (and the wheel fell through to the window behind).
                            // Drive the scrollable area from the bitmap height.
                            viewport-width: 760px;
                            viewport-height: root.source-img-h;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                            Rectangle {
                                // Sized to the rendered bitmap so the ScrollView
                                // scrolls it; width matches SOURCE_RENDER_W so
                                // pointer coords map 1:1 onto the word rects.
                                width: 760px;
                                height: root.source-img-h;
                                Image {
                                    x: 0;
                                    y: 0;
                                    width: 760px;
                                    height: root.source-img-h;
                                    source: root.source-img;
                                    image-fit: fill;
                                    image-rendering: smooth;
                                }
                                Rectangle {
                                    width: 760px;
                                    height: root.source-img-h;
                                    for sr in root.source-selection-rects: Rectangle {
                                        x: sr.x;
                                        y: sr.y;
                                        width: sr.w;
                                        height: sr.h;
                                        background: #10b9813d;
                                        border-radius: 2px;
                                    }
                                }
                                TouchArea {
                                    width: 760px;
                                    height: root.source-img-h;
                                    moved => {
                                        if (self.pressed) {
                                            root.src-sel-move(self.mouse-x, self.mouse-y);
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.button == PointerEventButton.left) {
                                            if (e.kind == PointerEventKind.down) {
                                                root.src-sel-start(self.mouse-x, self.mouse-y);
                                            } else if (e.kind == PointerEventKind.up) {
                                                root.src-sel-end();
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Headers: name / value table, in message order, inside a
                        // ScrollView (real scrollbar). Bottom padding keeps the
                        // last row clear of the modal's rounded edge.
                        if root.source-view-is-headers: ScrollView {
                            width: parent.width;
                            height: parent.height;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 12px;
                                padding-bottom: 16px;
                                spacing: 6px;
                                for h in root.source-view-headers: HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Text {
                                        text: h.name;
                                        width: 190px;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #0f1419;
                                        wrap: word-wrap;
                                    }
                                    KTextInput {
                                        text: h.value;
                                        read-only: true;
                                        single-line: false;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        color: #2b3640;
                                        selection-background-color: #10b981;
                                        selection-foreground-color: white;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // ---------- Delete-conversation confirmation (modal) ----------
    if root.from-mismatch-visible: TouchArea {
        // Swallows clicks behind the dialog; clicking the dimmed area cancels.
        clicked => {
            root.from-mismatch-visible = false;
            kb.focus();
            root.from-mismatch-cancel();
        }
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) {
                    root.from-mismatch-visible = false;
                    kb.focus();
                    root.from-mismatch-cancel();
                    return accept;
                }
                // No Enter-to-confirm here on purpose: this dialog exists
                // because a reflex already sent the wrong thing once.
                reject
            }
            Rectangle {
                background: #00000066;
                Rectangle {
                    width: min(520px, root.width - 80px);
                    height: fm-body.preferred-height + 40px;
                    background: white;
                    border-radius: 14px;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #00000044;
                    TouchArea {} // keep clicks inside the card from closing it
                    fm-body := VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        Text {
                            text: "Адрес отправителя не совпадает";
                            font-size: 17px; font-weight: 700; color: #0f1419;
                        }
                        Text {
                            text: "В этом диалоге вам пишут на " + root.from-mismatch-expected
                                + ", а отвечаете вы с " + root.from-mismatch-current + ".";
                            wrap: word-wrap;
                            font-size: 14px;
                            color: #2b3640;
                        }
                        Text {
                            text: "Отправить с адреса:";
                            font-size: 13px;
                            color: #64707d;
                        }
                        // Выпадающий список, а не строки: адресов может быть
                        // полсотни, и полсотни строк — это не диалог, это
                        // простыня. Предзаполнен тем адресом, на который пишут
                        // в диалоге, — то есть правильный выбор уже выбран.
                        ComboBox {
                            model: root.from-mismatch-options;
                            current-index: root.from-mismatch-index;
                            selected(value) => {
                                root.from-mismatch-index = self.current-index;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Отмена";
                                clicked => {
                                    root.from-mismatch-visible = false;
                                    kb.focus();
                                    root.from-mismatch-cancel();
                                }
                            }
                            Rectangle {
                                width: 190px; height: 34px;
                                border-radius: 8px;
                                background: fm-as-is.has-hover ? #d98324 : #f0994a;
                                Text {
                                    text: "Отправить";
                                    color: white; font-size: 13px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                                fm-as-is := TouchArea {
                                    clicked => {
                                        root.from-mismatch-visible = false;
                                        kb.focus();
                                        root.from-mismatch-pick(root.from-mismatch-index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.confirm-delete-visible: TouchArea {
        // Swallows clicks behind the dialog; clicking the dimmed area cancels.
        clicked => { root.confirm-delete-visible = false; kb.focus(); }
        // Enter = подтвердить, Escape = отмена. The scope grabs focus on
        // open and hands it back to the window key-sink on close.
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) {
                    root.confirm-delete-visible = false;
                    kb.focus();
                    return accept;
                }
                if (ev.text == Key.Return && !root.confirm-is-spam) {
                    root.confirm-delete-visible = false;
                    kb.focus();
                    root.delete-conversation-confirmed();
                    return accept;
                }
                reject
            }
        Rectangle {
            background: #00000066;
            Rectangle {
                width: min(440px, root.width - 80px);
                height: cd-body.preferred-height + 40px;
                background: white;
                border-radius: 14px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000044;
                TouchArea {} // keep clicks inside the card from closing it
                cd-body := VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    Text {
                        text: root.confirm-delete-title;
                        font-size: 17px; font-weight: 700; color: #0f1419;
                    }
                    Text {
                        text: root.confirm-delete-text;
                        wrap: word-wrap;
                        font-size: 14px;
                        color: #2b3640;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Отмена"; clicked => { root.confirm-delete-visible = false; kb.focus(); } }
                        // Spam mode: two block-scope buttons. Plain delete: one red button.
                        if root.confirm-is-spam: Rectangle {
                            width: 120px; height: 34px;
                            border-radius: 8px;
                            background: cd-addr.has-hover ? #d98324 : #f0994a;
                            Text { text: "Адрес в спам"; color: white; font-size: 13px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            cd-addr := TouchArea {
                                clicked => {
                                    root.confirm-delete-visible = false;
                                    kb.focus();
                                    root.spam-confirmed("address");
                                }
                            }
                        }
                        if root.confirm-is-spam: Rectangle {
                            width: 120px; height: 34px;
                            border-radius: 8px;
                            background: cd-dom.has-hover ? #d63d3d : #eb5757;
                            Text { text: "Домен в спам"; color: white; font-size: 13px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            cd-dom := TouchArea {
                                clicked => {
                                    root.confirm-delete-visible = false;
                                    kb.focus();
                                    root.spam-confirmed("domain");
                                }
                            }
                        }
                        if !root.confirm-is-spam: Rectangle {
                            width: 110px; height: 34px;
                            border-radius: 8px;
                            background: cd-del.has-hover ? #d63d3d : #eb5757;
                            Text { text: "Удалить"; color: white; font-size: 14px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            cd-del := TouchArea {
                                clicked => {
                                    root.confirm-delete-visible = false;
                                    kb.focus();
                                    root.delete-conversation-confirmed();
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // ---------- Snooze picker for calendar reminders (modal) ----------
    if root.snooze-visible: TouchArea {
        // Clicking the dimmed area cancels without a choice — the toast
        // resumes its countdown as if the button was never pressed.
        clicked => { root.snooze-visible = false; root.snooze-cancel(); kb.focus(); }
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) {
                    root.snooze-visible = false;
                    root.snooze-cancel();
                    kb.focus();
                    return accept;
                }
                reject
            }
        Rectangle {
            background: #00000066;
            Rectangle {
                width: min(420px, root.width - 80px);
                height: snz-body.preferred-height + 40px;
                background: white;
                border-radius: 14px;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000044;
                TouchArea {} // keep clicks inside the card from closing it
                snz-body := VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    Text {
                        text: "Отложить напоминание";
                        font-size: 17px; font-weight: 700; color: #0f1419;
                    }
                    Text {
                        text: root.snooze-summary;
                        wrap: word-wrap;
                        font-size: 14px;
                        color: #2b3640;
                    }
                    Text {
                        text: "Напомнить через:";
                        font-size: 13px; color: #5b6672;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        for opt in root.snooze-options: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: snz-min.has-hover ? #059669 : #10b981;
                            Text {
                                text: opt.label;
                                color: white; font-size: 14px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            snz-min := TouchArea {
                                clicked => {
                                    root.snooze-visible = false;
                                    kb.focus();
                                    root.snooze-choice(opt.value);
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 34px;
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: snz-at.has-hover ? #e8eef7 : #f0f4fa;
                            border-width: 1px; border-color: #c8d4e4;
                            Text {
                                text: "В момент начала";
                                color: #059669; font-size: 14px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            snz-at := TouchArea {
                                clicked => {
                                    root.snooze-visible = false;
                                    kb.focus();
                                    root.snooze-choice("atstart");
                                }
                            }
                        }
                        Button { text: "Отмена"; clicked => { root.snooze-visible = false; root.snooze-cancel(); kb.focus(); } }
                    }
                }
            }
        }
        }
    }

    // ---------- Event hover tooltip overlay ----------
    // Floats above the grid (single line, clamped to the window). The chip's
    // changed-has-hover arms it; the root Timer reveals it after a beat.
    if root.tip-visible && root.tip-text != "": Rectangle {
        x: min(root.tip-x, root.width - self.width - 8px);
        y: min(root.tip-y, root.height - self.height - 8px);
        width: min(460px, tip-label.preferred-width + 18px);
        height: tip-label.preferred-height + 10px;
        background: #1f2733;
        border-radius: 6px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        tip-label := Text {
            x: 9px; y: 5px;
            width: parent.width - 18px;
            text: root.tip-text;
            color: white;
            font-size: 12px;
            overflow: elide;
        }
    }

    // ---------- Settings modal ----------
    if root.settings-visible: TouchArea {
        clicked => { root.settings-visible = false; kb.focus(); }
        FocusScope {
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) {
                    root.settings-visible = false;
                    kb.focus();
                    return accept;
                }
                reject
            }
        Rectangle {
            background: #00000066;
            Rectangle {
                width: min(720px, root.width - 80px);
                height: min(520px, root.height - 80px);
                background: white;
                border-radius: 16px;
                drop-shadow-blur: 28px;
                drop-shadow-color: #00000044;
                clip: true;
                TouchArea {} // keep clicks inside from closing
                HorizontalLayout {
                    // ── Left rail: section tabs ──
                    Rectangle {
                        width: 196px;
                        background: #f7f8fa;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 4px;
                            Text {
                                text: "Настройки";
                                font-size: 18px; font-weight: 800; color: #0f1419;
                                horizontal-alignment: left;
                            }
                            Rectangle { height: 8px; }
                            for tab[i] in [
                                { ico: "🔔", label: "Уведомления" },
                                { ico: "🖼", label: "Контент" },
                                { ico: "📅", label: "Календарь" },
                                { ico: "🔌", label: "Подключение" },
                                { ico: "👤", label: "Аккаунты" },
                            ]: Rectangle {
                                height: 38px;
                                border-radius: 9px;
                                background: root.settings-tab == i
                                    ? #e8f0fe
                                    : (st-row.has-hover ? #eef1f5 : transparent);
                                st-row := TouchArea {
                                    clicked => { root.settings-tab = i; }
                                }
                                HorizontalLayout {
                                    padding-left: 12px; spacing: 10px; alignment: start;
                                    Text { text: tab.ico; font-size: 15px; vertical-alignment: center; }
                                    Text {
                                        text: tab.label;
                                        font-size: 14px;
                                        font-weight: root.settings-tab == i ? 700 : 500;
                                        color: root.settings-tab == i ? #059669 : #2b3640;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    // ── Right pane: active section ──
                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 6px;

                            // close (✕) in the top-right
                            Rectangle {
                                height: 0px;
                                Rectangle {
                                    x: parent.width - 26px; y: -4px;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: sx.has-hover ? #f0f2f5 : transparent;
                                    Path {
                                        x: 8px; y: 8px; width: 10px; height: 10px;
                                        viewbox-width: 10; viewbox-height: 10;
                                        stroke: #6b7480; stroke-width: 2px;
                                        MoveTo { x: 1; y: 1; } LineTo { x: 9; y: 9; }
                                        MoveTo { x: 9; y: 1; } LineTo { x: 1; y: 9; }
                                    }
                                    sx := TouchArea {
                                        clicked => { root.settings-visible = false; kb.focus(); }
                                    }
                                }
                            }

                            // ===== Уведомления =====
                            if root.settings-tab == 0: VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Уведомления";
                                    font-size: 16px; font-weight: 700; color: #0f1419;
                                }
                                Rectangle { height: 6px; }
                                SettingRow {
                                    title: "Звук нового письма";
                                    subtitle: "Короткий сигнал, когда диалог не открыт";
                                    Toggle {
                                        on: root.notify-sound-on;
                                        toggled => { root.toggle-notify-sound(); }
                                    }
                                }
                                Rectangle { height: 1px; background: #eef1f5; }
                                Text {
                                    text: "Тосты, счётчики непрочитанного и точка в трее включены всегда — отдельных переключателей пока нет.";
                                    font-size: 12px; color: #8b95a1; wrap: word-wrap;
                                }
                            }

                            // ===== Контент (media policy) =====
                            if root.settings-tab == 1: VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Внешний контент по умолчанию";
                                    font-size: 16px; font-weight: 700; color: #0f1419;
                                }
                                Text {
                                    text: "Глобальные правила. Точечные исключения для отправителя или хоста — в меню «Медиа…» на конкретном письме.";
                                    font-size: 12px; color: #8b95a1; wrap: word-wrap;
                                }
                                Rectangle { height: 8px; }
                                SettingRow {
                                    title: "Разрешить весь внешний контент";
                                    subtitle: "Картинки и скрипты грузятся без спроса";
                                    Toggle {
                                        on: root.media-allow-all-on;
                                        toggled => { root.set-media-global("allow-all"); }
                                    }
                                }
                                Rectangle { height: 1px; background: #eef1f5; }
                                SettingRow {
                                    title: "Загружать изображения";
                                    subtitle: "Внешние картинки во всех письмах";
                                    Toggle {
                                        enabled: !root.media-allow-all-on;
                                        on: root.media-all-images-on || root.media-allow-all-on;
                                        toggled => { root.set-media-global("images-all"); }
                                    }
                                }
                                Rectangle { height: 1px; background: #eef1f5; }
                                SettingRow {
                                    title: "Выполнять скрипты";
                                    subtitle: "Рискованно: разрешает JS во всех письмах";
                                    Toggle {
                                        enabled: !root.media-allow-all-on;
                                        on: root.media-all-scripts-on || root.media-allow-all-on;
                                        toggled => { root.set-media-global("scripts-all"); }
                                    }
                                }
                            }

                            // ===== Подключение =====
                            // ===== Календарь =====
                            if root.settings-tab == 2: VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Рабочий день";
                                    font-size: 16px; font-weight: 700; color: #0f1419;
                                }
                                Text {
                                    text: "Часы вне этого окна затеняются; когда все 24 часа не помещаются, видимым держится именно оно (плюс симметричный запас, если влезает).";
                                    font-size: 12px; color: #8b95a1; wrap: word-wrap;
                                }
                                Rectangle { height: 8px; }
                                SettingRow {
                                    title: "Начало";
                                    SpinBox {
                                        width: 110px;
                                        minimum: 0; maximum: 23;
                                        value: root.work-start;
                                        edited(v) => { root.set-work-hours(v, root.work-end); }
                                    }
                                }
                                Rectangle { height: 1px; background: #eef1f5; }
                                SettingRow {
                                    title: "Конец";
                                    SpinBox {
                                        width: 110px;
                                        minimum: 1; maximum: 24;
                                        value: root.work-end;
                                        edited(v) => { root.set-work-hours(root.work-start, v); }
                                    }
                                }

                                Rectangle { height: 16px; }
                                Text {
                                    text: "Календари";
                                    font-size: 16px; font-weight: 700; color: #0f1419;
                                }
                                Text {
                                    text: "Название — показать/скрыть; цветной квадрат — сменить цвет.";
                                    font-size: 12px; color: #8b95a1; wrap: word-wrap;
                                }
                                Rectangle { height: 6px; }
                                for c[ci] in root.calendars: Rectangle {
                                    height: 38px;
                                    border-radius: 8px;
                                    background: setcal-ta.has-hover ? #f5f6f8 : transparent;
                                    setcal-ta := TouchArea { clicked => { root.calendar-toggle-visibility(c.id); } }
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: start;
                                        Rectangle {
                                            width: 16px; height: 16px; y: (parent.height - self.height) / 2;
                                            border-radius: 4px;
                                            background: c.visible ? c.color : transparent;
                                            border-color: c.color; border-width: c.visible ? 0px : 1.5px;
                                            scp := TouchArea { clicked => { root.color-picker-cal = c.id; } }
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: c.name;
                                            font-size: 14px;
                                            color: c.visible ? #0f1419 : #8b95a1;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        Text {
                                            text: c.visible ? "показан" : "скрыт";
                                            font-size: 12px; color: #8b95a1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // ===== Подключения =====
                            if root.settings-tab == 3: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    Text {
                                        text: "Подключения";
                                        font-size: 16px; font-weight: 700; color: #0f1419;
                                        horizontal-stretch: 1; vertical-alignment: center;
                                    }
                                    acbtn := TouchArea {
                                        width: 130px; height: 34px;
                                        clicked => { root.add-connection(); }
                                        Rectangle {
                                            background: acbtn.has-hover ? #4f7df5 : #3a6df0;
                                            border-radius: 8px;
                                            Text { text: "+ Добавить"; color: white; font-size: 13px; font-weight: 600; }
                                        }
                                    }
                                }
                                if root.connections.length == 0: Text {
                                    text: "Нет подключений. Нажмите «Добавить».";
                                    font-size: 13px; color: #8b95a1;
                                }
                                for c[i] in root.connections: Rectangle {
                                    height: 58px;
                                    border-radius: 10px;
                                    background: #f7f8fa;
                                    border-width: 1px; border-color: #eef1f5;
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 10px; spacing: 8px;
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 1; spacing: 2px;
                                            Text { text: c.title; font-size: 14px; font-weight: 600; color: #0f1419; overflow: elide; }
                                            Text { text: c.subtitle; font-size: 12px; color: #6b7480; overflow: elide; }
                                        }
                                        ce := TouchArea {
                                            width: 74px;
                                            clicked => { root.edit-connection(i); }
                                            Rectangle {
                                                background: ce.has-hover ? #eef1f5 : transparent;
                                                border-radius: 7px;
                                                Text { text: "Изменить"; font-size: 12px; color: #2b3640; }
                                            }
                                        }
                                        cd := TouchArea {
                                            width: 68px;
                                            clicked => { root.delete-connection(i); }
                                            Rectangle {
                                                background: cd.has-hover ? #ffe1e1 : transparent;
                                                border-radius: 7px;
                                                Text { text: "Удалить"; font-size: 12px; color: #d64545; }
                                            }
                                        }
                                    }
                                }
                            }

                            // ===== Аккаунты =====
                            if root.settings-tab == 4: VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Аккаунты";
                                    font-size: 16px; font-weight: 700; color: #0f1419;
                                }
                                Rectangle {
                                    height: 96px;
                                    border-radius: 12px;
                                    background: #f7f8fa;
                                    border-width: 1px; border-color: #eef1f5;
                                    VerticalLayout {
                                        alignment: center; spacing: 4px;
                                        Text {
                                            text: "Управление аккаунтами скоро";
                                            font-size: 14px; font-weight: 600; color: #2b3640;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "Добавление почтовых ящиков, выбор активного, подключение внешних IMAP/SMTP.";
                                            font-size: 12px; color: #8b95a1; wrap: word-wrap;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }
        }
        }
    }

    // Connection light: green = every account connected, yellow = some down,
    // red = none. Clicking it opens the per-account list; clicking a row goes
    // to Settings → Аккаунты, which is where anything can be done about it.
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        x: 10px;
        y: root.height - self.height - 10px;
        background: root.conn-status == 2 ? #36b37e
                  : root.conn-status == 1 ? #ffab00
                  : #ff5630;
        border-width: 2px;
        border-color: #ffffffcc;
        // A 12px target is too small to hit; the touch area is bigger than
        // the dot it belongs to.
        TouchArea {
            x: -8px;
            y: -8px;
            width: 28px;
            height: 28px;
            clicked => { root.conn-menu-open = !root.conn-menu-open; }
        }
    }

    // Click-away catcher, below the panel in z-order.
    if root.conn-menu-open: TouchArea {
        clicked => { root.conn-menu-open = false; }
    }
    if root.conn-menu-open: Rectangle {
        x: 10px;
        y: root.height - self.height - 30px;
        width: 300px;
        height: cd-list.preferred-height + 8px;
        background: white;
        border-radius: 10px;
        border-width: 1px;
        border-color: #e3e6ea;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000026;
        drop-shadow-offset-y: 2px;
        TouchArea {} // keep clicks inside the panel from closing it
        cd-list := VerticalLayout {
            padding: 4px;
            if root.conn-accounts.length == 0: Text {
                height: 32px;
                text: "Нет настроенных учётных записей";
                font-size: 13px;
                color: #8b95a1;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            for acc in root.conn-accounts: Rectangle {
                height: 42px;
                border-radius: 8px;
                background: acc-ta.has-hover ? #f0f4fa : transparent;
                acc-ta := TouchArea {
                    clicked => {
                        root.conn-menu-open = false;
                        root.settings-tab = 3;
                        root.settings-visible = true;
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    Rectangle {
                        width: 10px;
                        Rectangle {
                            y: 16px;
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: acc.ok ? #36b37e : #ff5630;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: acc.title;
                            font-size: 13px;
                            color: #0f1419;
                            overflow: elide;
                        }
                        Text {
                            text: acc.subtitle;
                            font-size: 11px;
                            color: #8b95a1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// ── Calendar reminder toast (own frameless always-on-top window) ──
// One component serves both kinds:
//   A «скоро случится» → show-action=true (── «Напомнить позже»), X closes.
//   B «наступило»      → show-action=false, click body raises+opens, X deletes.
// Behavioural rules (timeout, delete-on-X, snooze dialog) live in Rust; this
// is pure presentation. The whole card is a body-click target EXCEPT the X and
// the action button, which sit above it in z-order and swallow their clicks.
export component ToastWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    width: 360px;
    height: 128px;

    in property <string> toast-title;
    in property <string> toast-body;
    in property <bool> show-action: false;
    in property <string> action-label: "Напомнить позже";
    // 1 = «скоро» (accent blue), 2 = «наступило» (accent amber).
    in property <int> kind: 1;
    // Auto-close countdown. `timeout-ms`: total (0 = no timeout, no bar).
    // `progress`: 0.0 = just shown (bar full) → 1.0 = expired (bar empty),
    // driven from Rust each tick (a bound `animate` duration proved unreliable).
    in property <int> timeout-ms: 0;
    in property <float> progress: 0.0;

    callback close-clicked();
    callback body-clicked();
    callback action-clicked();

    Rectangle {
        background: #23262b;
        border-radius: 12px;
        border-width: 1px;
        border-color: #3a3f47;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000aa;

        // Whole-card click target (below the buttons in z-order).
        body-ta := TouchArea {
            clicked => { root.body-clicked(); }
        }

        // Accent stripe on the left edge.
        Rectangle {
            x: 0; y: 0; width: 4px; height: parent.height;
            background: root.kind == 2 ? #ffab00 : #3a6df0;
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }

        VerticalLayout {
            padding: 14px;
            padding-left: 16px;
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.toast-title;
                    font-size: 15px;
                    font-weight: 700;
                    color: #ffffff;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
                close-ta := TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.close-clicked(); }
                    Rectangle {
                        background: close-ta.has-hover ? #3a3f47 : transparent;
                        border-radius: 6px;
                        // Drawn cross — the ✕ glyph is missing from the
                        // default font on Windows (same story as the burger
                        // and the chevrons).
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 10px;
                            height: 10px;
                            commands: "M 0 0 L 10 10 M 10 0 L 0 10";
                            stroke: #aeb6c2;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                    }
                }
            }

            Text {
                text: root.toast-body;
                font-size: 13px;
                color: #c7cdd6;
                wrap: word-wrap;
                vertical-stretch: 1;
                overflow: elide;
            }

            if root.show-action : HorizontalLayout {
                alignment: end;
                action-ta := TouchArea {
                    width: action-bg.preferred-width;
                    height: 28px;
                    clicked => { root.action-clicked(); }
                    action-bg := Rectangle {
                        background: action-ta.has-hover ? #4f7df5 : #3a6df0;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: root.action-label;
                                color: #ffffff;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Countdown bar: drains full→empty over `timeout-ms`. Sized off `root`
        // (the window) — `parent` inside an `if` can resolve to a zero-size
        // wrapper. No big corner radius: a radius larger than the 4px height
        // makes the renderer drop the rect entirely. Plain Rectangle (no
        // TouchArea) so it never swallows body clicks.
        if root.timeout-ms > 0 : Rectangle {
            x: 4px;
            y: root.height - 5px;
            height: 4px;
            width: (root.width - 8px) * (1.0 - root.progress);
            background: root.kind == 2 ? #ffab00 : #3a6df0;
            border-radius: 2px;
        }
    }
}

// First-run login: shown instead of the main window when no account is
// configured. Rust does the actual HTTP round-trip (submit → busy → either
// error text or the window is hidden and startup continues).
export component LoginWindow inherits Window {
    title: "ddmail — вход";
    width: 440px;
    height: 700px;
    background: #1b1e23;

    // 0 = DDMail (our server, native); 1 = standalone (any IMAP + optional
    // CalDAV/CardDAV).
    in-out property <int> mode: 0;

    // Native mode.
    in-out property <string> server-url: "https://mail.letotam.ru";
    // Shared.
    in-out property <string> username: "";
    in-out property <string> password: "";
    // Standalone mode.
    in-out property <string> email: "";
    in-out property <string> imap-host: "";
    in-out property <string> imap-port: "993";
    in-out property <string> caldav-url: "";
    in-out property <string> carddav-url: "";

    in property <string> error: "";
    in property <bool> busy: false;
    // Google sign-in is offered only when client creds are present on this
    // machine (google_oauth.json).
    in property <bool> google-available: false;

    callback submit();
    callback google-login();

    VerticalLayout {
        padding: 28px;
        spacing: 8px;

        Text {
            text: "ddmail";
            font-size: 26px; font-weight: 800; color: #ffffff;
            horizontal-alignment: center;
        }
        Text {
            text: "Подключение почты";
            font-size: 13px; color: #aeb6c2;
            horizontal-alignment: center;
        }
        Rectangle { height: 6px; }

        // Account-type toggle.
        HorizontalLayout {
            spacing: 0px;
            height: 38px;
            tab-native := TouchArea {
                clicked => { root.mode = 0; }
                Rectangle {
                    background: root.mode == 0 ? #3a6df0 : #23262b;
                    border-top-left-radius: 8px; border-bottom-left-radius: 8px;
                    Text { text: "Наш сервер"; color: root.mode == 0 ? #ffffff : #aeb6c2; font-size: 13px; font-weight: 600; }
                }
            }
            tab-standalone := TouchArea {
                clicked => { root.mode = 1; }
                Rectangle {
                    background: root.mode == 1 ? #3a6df0 : #23262b;
                    border-top-right-radius: 8px; border-bottom-right-radius: 8px;
                    Text { text: "Другой (IMAP)"; color: root.mode == 1 ? #ffffff : #aeb6c2; font-size: 13px; font-weight: 600; }
                }
            }
        }
        Rectangle { height: 4px; }

        // Fields scroll (the standalone form is taller than the window) while
        // the buttons below stay pinned and always reachable.
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;

                // ── Native fields ──
                if root.mode == 0: Text { text: "Сервер"; font-size: 12px; color: #aeb6c2; }
                if root.mode == 0: KLineEdit {
                    text <=> root.server-url; font-size: 14px; enabled: !root.busy;
                }

                // ── Standalone fields ──
                if root.mode == 1: Text { text: "Email"; font-size: 12px; color: #aeb6c2; }
                if root.mode == 1: KLineEdit {
                    text <=> root.email; font-size: 14px; enabled: !root.busy;
                    placeholder-text: "you@example.com";
                }
                if root.mode == 1: Text { text: "IMAP-сервер"; font-size: 12px; color: #aeb6c2; }
                if root.mode == 1: KLineEdit {
                    text <=> root.imap-host; font-size: 14px; enabled: !root.busy;
                    placeholder-text: "imap.example.com";
                }
                if root.mode == 1: Text { text: "IMAP-порт"; font-size: 12px; color: #aeb6c2; }
                if root.mode == 1: KLineEdit {
                    text <=> root.imap-port; font-size: 14px; enabled: !root.busy;
                }

                // ── Shared credentials ──
                Text { text: "Логин"; font-size: 12px; color: #aeb6c2; }
                KLineEdit {
                    text <=> root.username; font-size: 14px; enabled: !root.busy;
                }
                Text { text: "Пароль"; font-size: 12px; color: #aeb6c2; }
                pass-edit := KLineEdit {
                    text <=> root.password; font-size: 14px;
                    input-type: InputType.password; enabled: !root.busy;
                    accepted => { root.submit(); }
                }

                // ── Optional standalone calendar/contacts ──
                if root.mode == 1: Text { text: "CalDAV URL (необязательно)"; font-size: 12px; color: #aeb6c2; }
                if root.mode == 1: KLineEdit {
                    text <=> root.caldav-url; font-size: 14px; enabled: !root.busy;
                    placeholder-text: "https://…/calendars/…/";
                }
                if root.mode == 1: Text { text: "CardDAV URL (необязательно)"; font-size: 12px; color: #aeb6c2; }
                if root.mode == 1: KLineEdit {
                    text <=> root.carddav-url; font-size: 14px; enabled: !root.busy;
                    placeholder-text: "https://…/addressbooks/…/";
                }
            }
        }

        Text {
            text: root.error;
            font-size: 12px; color: #ff6b6b; height: 18px; overflow: elide;
        }

        submit-ta := TouchArea {
            height: 42px;
            enabled: !root.busy;
            clicked => { root.submit(); }
            Rectangle {
                background: root.busy ? #2c3e66 : (submit-ta.has-hover ? #4f7df5 : #3a6df0);
                border-radius: 8px;
                Text {
                    text: root.busy ? "Подключаем…" : (root.mode == 0 ? "Войти" : "Подключить");
                    color: #ffffff; font-size: 15px; font-weight: 700;
                }
            }
        }

        // Google sign-in (standalone OAuth). Shown when creds are configured.
        if root.google-available: gbtn := TouchArea {
            height: 40px;
            enabled: !root.busy;
            clicked => { root.google-login(); }
            Rectangle {
                background: gbtn.has-hover ? #2a2e35 : #23262b;
                border-radius: 8px;
                border-width: 1px;
                border-color: #3a3f47;
                Text {
                    text: "Войти через Google";
                    color: #e8eaed; font-size: 14px; font-weight: 600;
                }
            }
        }
    }
}
