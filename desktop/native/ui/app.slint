import { ListView } from "std-widgets.slint";

struct ConvItem {
    name: string,
    preview: string,
    initials: string,
    color: brush,
    time: string,
    avatar: image,
    has-avatar: bool,
}

// Each message row is a full-width image rendered by Blitz (bubble, alignment,
// formatting and network images all done in HTML/CSS inside Blitz).
struct RowItem {
    img: image,
    h: length,
}

export component MainWindow inherits Window {
    title: "ddmail";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 1080px;
    min-height: 600px;

    in property <[ConvItem]> conversations;
    in property <[RowItem]> messages;
    in-out property <int> selected: 0;
    in property <string> active-name;
    in property <string> active-initials;
    in property <brush> active-color;
    callback select(int);
    callback hit-test(int, length, length);
    callback viewport-resized(length);
    callback send(string);
    callback msg-action(int, string);
    callback search(string);

    HorizontalLayout {
        spacing: 0px;

        // ---------- Sidebar ----------
        Rectangle {
            width: 320px;
            background: #f7f8fa;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    Rectangle {
                        x: 10px;
                        y: 10px;
                        width: parent.width - 20px;
                        height: 36px;
                        background: #eceef0;
                        border-radius: 18px;
                        si := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            vertical-alignment: center;
                            color: #0f1419;
                            font-size: 14px;
                            single-line: true;
                            accepted => {
                                if (self.text != "") { root.search(self.text); }
                            }
                        }
                        if si.text == "": Text {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            text: "Поиск…";
                            color: #8b95a1;
                            vertical-alignment: center;
                        }
                    }
                }
                ListView {
                    for conv[idx] in root.conversations: Rectangle {
                        height: 64px;
                        background: idx == root.selected ? #2f80ed : transparent;
                        TouchArea {
                            clicked => { root.select(idx); }
                        }
                        HorizontalLayout {
                            padding: 9px;
                            spacing: 12px;
                            Rectangle {
                                width: 46px;
                                height: 46px;
                                border-radius: 23px;
                                background: conv.color;
                                clip: true;
                                if !conv.has-avatar: Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: conv.initials;
                                    color: white;
                                    font-weight: 700;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if conv.has-avatar: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: conv.avatar;
                                    image-fit: cover;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: conv.name;
                                    font-weight: 700;
                                    font-size: 15px;
                                    color: idx == root.selected ? white : #0f1419;
                                }
                                Text {
                                    text: conv.preview;
                                    font-size: 13px;
                                    color: idx == root.selected ? #e8f0fe : #8b95a1;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------- Main ----------
        VerticalLayout {
            Rectangle {
                height: 60px;
                background: white;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    alignment: start;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: root.active-color;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.active-initials;
                            color: white;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: root.active-name; font-weight: 700; font-size: 16px; }
                        Text { text: "был(а) недавно"; color: #8b95a1; font-size: 13px; }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: #e9eef5;
                // Tell Rust the chat width so Blitz re-renders rows to fill it.
                changed width => { root.viewport-resized(self.width); }
                ListView {
                    for msg[idx] in root.messages: Rectangle {
                        height: msg.h;
                        cma := ContextMenuArea {
                            Menu {
                                MenuItem { title: "Ответить"; activated => { root.msg-action(idx, "reply"); } }
                                MenuItem { title: "Прочитано"; activated => { root.msg-action(idx, "read"); } }
                                MenuItem { title: "Не прочитано"; activated => { root.msg-action(idx, "unread"); } }
                                MenuItem { title: "Копировать текст"; activated => { root.msg-action(idx, "copy"); } }
                                MenuSeparator { }
                                MenuItem { title: "Удалить"; activated => { root.msg-action(idx, "delete"); } }
                            }
                            Image {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: msg.h;
                                source: msg.img;
                                image-fit: contain;
                                image-rendering: smooth;
                            }
                        }
                        // Whole-bubble pointer handling: left click → hit-test in
                        // Blitz for a link; right click → open the native menu.
                        TouchArea {
                            width: parent.width;
                            height: msg.h;
                            clicked => { root.hit-test(idx, self.mouse-x, self.mouse-y); }
                            pointer-event(e) => {
                                if (e.button == PointerEventButton.right
                                    && e.kind == PointerEventKind.down) {
                                    cma.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 64px;
                background: white;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: #f0f2f5;
                        border-radius: 20px;
                        ti := TextInput {
                            x: 16px;
                            width: parent.width - 32px;
                            height: parent.height;
                            vertical-alignment: center;
                            color: #0f1419;
                            font-size: 15px;
                            single-line: true;
                            accepted => {
                                if (self.text != "") { root.send(self.text); self.text = ""; }
                            }
                        }
                        if ti.text == "": Text {
                            x: 16px;
                            width: parent.width - 32px;
                            height: parent.height;
                            text: "Написать сообщение…";
                            color: #8b95a1;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: #2f80ed;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "→";
                            color: white;
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                if (ti.text != "") { root.send(ti.text); ti.text = ""; }
                            }
                        }
                    }
                }
            }
        }
    }
}
