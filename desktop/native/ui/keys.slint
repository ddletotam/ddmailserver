// Поля ввода с раскладко-независимыми Ctrl+C/X/V/A. Отдельный файл —
// нужны и главному окну, и модалке настроек (settings.slint).

import { LineEdit } from "std-widgets.slint";

// Which editing action a key press means, decided in Rust against the
// *current* keyboard layout.
//
// Slint cannot answer this: its own shortcut matcher compares `event.text`
// with the latin letters "c"/"x"/"v"/"a" (i-slint-core/input.rs), so on any
// non-latin layout neither the built-in handling nor anything written in
// `.slint` fires. The character is all we get — so Rust asks the OS which
// physical key produces that character right now, and answers by key.
//
// 0 none, 1 copy, 2 paste, 3 cut, 4 select-all.
export global Shortcuts {
    // `held` must be "Ctrl is down and Alt is not". It is a parameter rather
    // than something the caller is trusted to check first, because forgetting
    // it turns every letter into a shortcut — plain "a" selected all and "x"
    // cut the selection.
    //
    // Alt is excluded because AltGr reports itself as Ctrl+Alt on Windows, and
    // on layouts that put characters there, typing would fire shortcuts.
    callback action(string, bool) -> int;
}

// Раскладко-независимые Ctrl+C/X/V/A.
//
// Slint сопоставляет клавиатурные шорткаты по СИМВОЛУ события
// (i-slint-core/input.rs: `match key_event.text { "c" => Copy, ... }`), а
// winit кладёт в `text` символ ТЕКУЩЕЙ раскладки. Под ЙЦУКЕН приходят
// «с»/«ч»/«м»/«ф» — ни один шорткат не матчится, и буфер обмена молча
// перестаёт работать во всех полях ввода (карточка события, композер,
// поиск, логин). Физических кодов клавиш Slint наружу не отдаёт, поэтому
// классифицируем событие сами — по кириллическим буквам тех же клавиш.
//
// Латиницу не перехватываем: там штатный путь Slint работает.

// TextInput с починенными шорткатами (см. global Kb). Все поля ввода в
// приложении — это он, а не голый TextInput.
//
// Собственные шорткаты поля (Enter=отправить, Esc, стрелки) вешаются на
// `extra-key-pressed`: `key-pressed` уже занят и вызывает его последним,
// после clipboard-шорткатов. Без хука биндинг на месте использования
// перекрыл бы наш обработчик и починка потерялась бы молча.
export component KTextInput inherits TextInput {
    callback extra-key-pressed(event: KeyEvent) -> EventResult;
    // Ctrl зажат, Alt нет, Shift нет: AltGr представляется как Ctrl+Alt, а
    // Ctrl+Shift — это другой набор шорткатов.
    property <bool> held: false;
    key-pressed(ev) => {
        self.held = ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.shift;
        if (Shortcuts.action(ev.text, self.held) == 1) { self.copy(); return accept; }
        if (Shortcuts.action(ev.text, self.held) == 4) { self.select-all(); return accept; }
        // Мутирующие — только в редактируемом поле (штатный путь Slint
        // проверяет read-only так же).
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 3) { self.cut(); return accept; }
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 2) { self.paste(); return accept; }
        return self.extra-key-pressed(ev);
    }
}

// То же для std-widget LineEdit (настройки/логин/контакты) — у него
// шорткаты ломаются по той же причине.
export component KLineEdit inherits LineEdit {
    property <bool> held: false;
    key-pressed(ev) => {
        self.held = ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.shift;
        if (Shortcuts.action(ev.text, self.held) == 1) { self.copy(); return accept; }
        if (Shortcuts.action(ev.text, self.held) == 4) { self.select-all(); return accept; }
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 3) { self.cut(); return accept; }
        if (!self.read-only && Shortcuts.action(ev.text, self.held) == 2) { self.paste(); return accept; }
        return reject;
    }
}
