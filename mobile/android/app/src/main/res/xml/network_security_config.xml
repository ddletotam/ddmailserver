<?xml version="1.0" encoding="utf-8"?>
<!-- Контракт §3: только https; доверяем системным CA и CA, установленным
     пользователем (корпоративные), — как десктоп доверяет хранилищу ОС. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
