<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Права Notification Service Extension (контракт §7): общий кэш и учётки
     (App Group), сессии ddmail-учёток (та же группа связки ключей, что у приложения). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DDMAIL_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ru.letotam.ddmail</string>
	</array>
</dict>
</plist>
